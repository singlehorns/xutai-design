---
import Layout from "@/components/Layout.astro";
import { getCases } from "@/data/cases";
import type { CaseViewModel } from "@/data/case-model";
import { site } from "@/data/site";
import { withBase } from "@/utils/paths";

const serviceItems = [
  {
    id: "website-maintenance",
    number: "01",
    english: "WEB SITE",
    title: "網站建置・維護管理",
    statement: "讓網站成為客戶認識你、查看服務與聯絡的重要入口。",
    image: "/images/works/shiroki-sr-sitetop.jpg",
    imagePosition: "center top",
    imageLabel: "網站 Mockup / Desktop + Mobile",
    description: [
      "公司網站除了提供基本資訊，也經常是客戶認識公司、查看服務與聯絡的重要管道。",
      "可協助企業與商家進行網站規劃、設計與建置，包含既有網站改版、WordPress 網站以及活動頁面等。網站上線後，如有持續更新的需求，也能協助處理內容、主機及網站日常維護。"
    ],
    points: ["公司形象網站", "品牌網站", "WordPress", "RWD 網頁", "活動頁面", "網站改版", "網站內容更新", "主機與網域", "網站維護", "GA4", "Search Console", "基礎 SEO"],
    recentCaseSlugs: ["shiroki-sr", "bestbrass"]
  },
  {
    id: "event-education",
    number: "03",
    english: "EVENT / EDUCATION",
    title: "活動・教育推廣",
    statement: "從活動前期宣傳，到報名資訊與現場製作物一起規劃。",
    image: "/images/works/itayamachibaru-capture.jpg",
    imagePosition: "center center",
    imageLabel: "研習、競賽、食農教育展覽或現場照片",
    description: [
      "學校研習、競賽、招生或推廣活動，除了前期宣傳之外，通常還會需要報名資訊、活動手冊、現場展示及相關製作物。",
      "過去有參與學校研習與競賽相關製作，也曾協助食農教育的假日展覽，因此可以依照不同活動內容，協助規劃宣傳、報名到活動現場所需要的設計與製作項目。"
    ],
    points: ["研習活動", "競賽活動", "招生宣傳", "活動主視覺", "活動網頁", "報名頁面", "活動手冊", "現場展示", "展覽佈置", "活動周邊"],
    recentCaseSlugs: ["itayamachibaru", "iwata-shotenkai-flyer"]
  },
  {
    id: "social-ads",
    number: "04",
    english: "SOCIAL MEDIA / ADS",
    title: "社群・廣告推廣",
    statement: "配合日常曝光、招生與活動檔期，安排社群內容與廣告導流。",
    image: "/images/works/tokaiunit-sitetop.jpg",
    imagePosition: "center top",
    imageLabel: "IG 貼文、Meta Ads、招生宣傳素材",
    description: [
      "社群可以用來維持日常曝光，也可以配合招生、活動或特定期間進行宣傳。",
      "目前有協助公司與學校進行社群貼文製作與發布，並依照活動時間安排 Meta 廣告，將看到廣告的人導向網站或報名頁面。廣告發布後，也可以查看基本成效，作為下一次內容與投放方式調整的參考。"
    ],
    points: ["社群貼文", "貼文視覺", "內容發布", "Meta 廣告", "活動宣傳", "招生宣傳", "網站導流", "報名頁導流", "廣告基本數據整理"],
    recentCaseSlugs: ["tokaiunit", "web-portfolio-links"]
  },
  {
    id: "print-production",
    number: "05",
    english: "PRINT / PRODUCTION",
    title: "商家印刷・製作",
    statement: "從設計、印刷規格確認，到實際製作一起處理。",
    image: "/images/works/iwata-shotenkai-flyer.jpg",
    imagePosition: "center center",
    imageLabel: "菜單、貼紙、DM、壓克力製作成品",
    description: [
      "店家平常會使用到的菜單、貼紙、傳單或其他宣傳品，除了設計之外，還需要考慮尺寸、材質、數量以及實際製作方式。",
      "目前有配合商家、補習班等單位進行印刷製作，可從版面設計、印刷規格確認到後續製作一起處理，減少另外尋找設計與印刷窗口的時間。"
    ],
    points: ["菜單", "DM", "傳單", "海報", "貼紙", "名片", "型錄", "補習班宣傳品", "活動印刷品", "壓克力製作", "印刷完稿", "材質建議"],
    recentCaseSlugs: ["glitter8-catalog", "iwata-shotenkai-flyer"]
  }
];

const cases = await getCases();
const casesBySlug = new Map(cases.map((caseStudy) => [caseStudy.slug, caseStudy]));
const isCase = (caseStudy: CaseViewModel | undefined): caseStudy is CaseViewModel => Boolean(caseStudy);
const servicesWithCases = serviceItems.map((service) => ({
  ...service,
  recentCases: service.recentCaseSlugs.map((slug) => casesBySlug.get(slug)).filter(isCase).slice(0, 2)
}));
const getCaseStatus = (caseStudy: CaseViewModel) => caseStudy.contentStatus === "legacy" ? "已完成" : "進行中";
---

<Layout title={`SERVICE／服務項目 | ${site.siteName}`} description={`網站、品牌視覺、活動製作、社群與印刷等服務項目，由 ${site.ownerDisplayName} 依實際需求確認適合的執行方式。`} mainClass="services-editorial-shell">
  <main class="services-editorial" aria-labelledby="services-title">
    <header class="services-hero">
      <p class="services-hero__kicker">SERVICE</p>
      <h1 id="services-title">可以協助的服務</h1>
      <div class="services-hero__intro">
        <p>平常接觸的工作包含網站、品牌視覺、活動製作、社群以及印刷等不同項目。</p>
        <p>有些案件只需要完成一項設計，也有些案件會從網站、宣傳到實體製作一起進行。依照實際需求討論需要的項目，再決定適合的執行方式。</p>
      </div>
      <nav class="services-anchor" aria-label="服務項目導覽">
        {servicesWithCases.map((service) => (
          <a href={`#${service.id}`}>
            <span>{service.number}</span>
            <strong>{service.title}</strong>
          </a>
        ))}
      </nav>
    </header>

    <div class="services-sections">
      {servicesWithCases.map((service) => (
        <article id={service.id} class="service-section" aria-labelledby={`${service.id}-title`}>
          <figure class="service-image" style={`--image-position: ${service.imagePosition};`}>
            <img src={withBase(service.image)} alt={service.imageLabel} loading="lazy" />
            <figcaption>
              <span>{service.english}</span>
              <h2 id={`${service.id}-title`}>{service.title}</h2>
            </figcaption>
          </figure>

          <div class="service-copy">
            <aside class="service-copy__mark">
              <div class="service-copy__mark-head" aria-hidden="true">
                <span>{service.number}</span>
                <small>{service.english}</small>
              </div>
              {service.recentCases.length > 0 && (
                <section class="service-cases" aria-labelledby={`${service.id}-cases`}>
                  <h3 id={`${service.id}-cases`}>近期案件</h3>
                  <ul>
                    {service.recentCases.map((caseStudy) => (
                      <li>
                        <a href={withBase(caseStudy.url)}>
                          <span class="service-cases__title">{caseStudy.shortTitle}</span>
                          <small class="service-cases__status-row">
                            <b>目前狀態</b>
                            <span class={`service-cases__status service-cases__status--${getCaseStatus(caseStudy) === "已完成" ? "done" : "active"}`}>
                              {getCaseStatus(caseStudy)}
                            </span>
                          </small>
                          <em aria-hidden="true">↗</em>
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
            </aside>
            <div class="service-copy__main">
              <p class="service-copy__statement">{service.statement}</p>
              <div class="service-copy__description">
                {service.description.map((paragraph) => <p>{paragraph}</p>)}
              </div>
              <div class="service-points">
                <h3>可以協助的項目</h3>
                <ul>
                  {service.points.map((point) => <li>{point}</li>)}
                </ul>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <section class="services-contact" aria-labelledby="services-contact-title">
      <p class="services-contact__label">CONTACT</p>
      <h2 id="services-contact-title">有明確需求，<br />來找 T2 聊聊！</h2>
      <p>可以先分享目前遇到的網站、品牌、活動、社群或印刷需求，一起確認適合的服務範圍與合作方式。</p>
      <a href={withBase("/contact/")}>討論合作需求 <span aria-hidden="true">→</span></a>
    </section>
  </main>
</Layout>

<style>
  :global(.services-editorial-shell) {
    background: #fff;
  }

  .services-editorial {
    width: 100%;
    margin-inline: auto;
    padding-block: clamp(72px, 8vw, 118px) clamp(72px, 8vw, 112px);
    overflow: hidden;
  }

  .services-hero {
    width: min(calc(100% - var(--home-safe) * 2), 1180px);
    min-height: clamp(430px, 58vh, 600px);
    display: grid;
    align-content: center;
    justify-items: center;
    margin-inline: auto;
    text-align: center;
  }

  .services-hero__kicker {
    margin: 0;
    font-family: "Manrope", "Noto Sans TC", sans-serif;
    font-size: clamp(3rem, 7vw, 6.7rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: 0.3em;
    text-indent: 0.3em;
  }

  .services-hero h1 {
    margin: 18px 0 0;
    font-size: clamp(0.92rem, 1.2vw, 1.08rem);
    font-weight: 700;
    letter-spacing: 0.24em;
  }

  .services-hero__intro {
    display: grid;
    gap: clamp(16px, 2vw, 24px);
    width: min(660px, 100%);
    margin-top: clamp(54px, 7vw, 80px);
  }

  .services-hero__intro p {
    margin: 0;
    color: #555;
    font-size: clamp(0.92rem, 1.05vw, 1.02rem);
    font-weight: 500;
    line-height: 2.05;
    letter-spacing: 0.07em;
  }

  .services-anchor {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 22px;
    width: min(880px, 100%);
    margin-top: clamp(44px, 7vw, 72px);
  }

  .services-anchor a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 38px;
    padding-bottom: 8px;
    border-bottom: 1px solid #d8d2c5;
    color: var(--home-ink);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .services-anchor a:hover {
    border-color: var(--home-yellow);
    color: #a87908;
    text-decoration: none;
  }

  .services-anchor span {
    color: #a87908;
    font-family: "Manrope", "Noto Sans TC", sans-serif;
    font-size: 0.72rem;
    font-weight: 900;
  }

  .services-sections {
    display: grid;
    gap: clamp(64px, 8vw, 112px);
    margin-top: clamp(28px, 5vw, 64px);
  }

  .service-section {
    scroll-margin-top: 100px;
  }

  .service-image {
    position: relative;
    width: 100%;
    height: clamp(330px, 38vw, 520px);
    margin: 0;
    overflow: hidden;
    background: #111;
  }

  .service-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--image-position, center center);
    filter: grayscale(6%) saturate(0.9) brightness(0.72);
    transform: scale(1.02);
  }

  .service-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.22);
    pointer-events: none;
  }

  .service-image figcaption {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: clamp(14px, 2vw, 24px);
    color: #fff;
    text-align: center;
  }

  .service-image figcaption span {
    font-family: "Manrope", "Noto Sans TC", sans-serif;
    font-size: clamp(0.66rem, 0.86vw, 0.82rem);
    font-weight: 800;
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    line-height: 1;
    opacity: 0.96;
  }

  .service-image h2 {
    margin: 0;
    max-width: calc(100% - 40px);
    font-family: "Manrope", "Noto Sans TC", sans-serif;
    font-size: clamp(1.35rem, 2.65vw, 2.35rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: 0.16em;
    text-indent: 0.16em;
    white-space: nowrap;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.32);
  }

  .service-copy {
    display: grid;
    grid-template-columns: minmax(160px, 0.36fr) minmax(0, 0.88fr);
    gap: clamp(34px, 6vw, 78px);
    width: min(1020px, 100%);
    margin: clamp(48px, 5.8vw, 76px) auto 0;
  }

  .service-copy__mark {
    display: grid;
    align-content: start;
    gap: clamp(18px, 2.8vw, 32px);
    padding-top: 8px;
  }

  .service-copy__mark-head {
    display: grid;
    gap: 16px;
  }

  .service-copy__mark-head span {
    width: max-content;
    color: var(--home-yellow);
    font-family: "Manrope", "Noto Sans TC", sans-serif;
    font-size: clamp(2.8rem, 5vw, 5.2rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .service-copy__mark-head small {
    max-width: 180px;
    color: #777;
    font-family: "Manrope", "Noto Sans TC", sans-serif;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    line-height: 1.6;
  }

  .service-copy__main {
    min-width: 0;
  }

  .service-copy__statement {
    margin: 0;
    color: var(--home-ink);
    font-size: clamp(1.3rem, 2.1vw, 2rem);
    font-weight: 800;
    line-height: 1.8;
    letter-spacing: 0.12em;
  }

  .service-copy__description {
    display: grid;
    gap: 12px;
    margin-top: clamp(22px, 3vw, 32px);
  }

  .service-copy__description p {
    margin: 0;
    color: #4f4f4f;
    font-size: clamp(0.94rem, 1vw, 1.02rem);
    font-weight: 500;
    line-height: 2.05;
    letter-spacing: 0.04em;
  }

  .service-points {
    position: relative;
    margin-top: clamp(36px, 5vw, 56px);
    padding-top: clamp(34px, 4vw, 46px);
  }

  .service-points::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: clamp(26px, 2.6vw, 36px);
    background-position: left top;
    background-repeat: repeat;
    opacity: 0.92;
  }

  #website-maintenance .service-points::before {
    background-image:
      linear-gradient(#d6cbb4, #d6cbb4),
      linear-gradient(#d6cbb4, #d6cbb4),
      linear-gradient(#d6cbb4, #d6cbb4),
      linear-gradient(#d6cbb4, #d6cbb4);
    background-size: 100% 1px, 100% 1px, 100% 1px, 100% 1px;
    background-position: 0 3px, 0 8px, 0 20px, 0 25px;
    background-repeat: repeat-x;
  }

  #event-education .service-points::before {
    height: clamp(34px, 3.2vw, 44px);
    background-image:
      linear-gradient(90deg, rgba(214, 203, 180, 0.92) 1px, transparent 1px),
      linear-gradient(rgba(214, 203, 180, 0.92) 1px, transparent 1px);
    background-size: 22px 12px;
    background-position: left top;
    background-repeat: repeat;
  }

  #social-ads .service-points::before {
    height: clamp(28px, 2.8vw, 40px);
    background-image: radial-gradient(circle, rgba(214, 203, 180, 0.95) 0 2px, transparent 2.4px);
    background-size: 20px 12px;
    background-position: 0 0;
    background-repeat: repeat;
  }

  #print-production .service-points::before {
    background-image:
      repeating-linear-gradient(90deg, #d6cbb4 0 18px, transparent 18px 28px),
      repeating-linear-gradient(90deg, transparent 0 8px, #d6cbb4 8px 16px, transparent 16px 28px),
      linear-gradient(#d6cbb4, #d6cbb4);
    background-size: 28px 1px, 28px 1px, 100% 1px;
    background-position: 0 4px, 0 16px, 0 28px;
    background-repeat: repeat-x;
  }

  .service-points h3 {
    margin: 0;
    color: var(--home-ink);
    font-size: 0.96rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .service-points ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 13px 34px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .service-points li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 10px;
    color: #333;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.75;
    letter-spacing: 0.04em;
  }

  .service-points li::before {
    content: "";
    width: 0.55em;
    height: 0.55em;
    background: var(--home-yellow);
    transform: translateY(-0.02em);
  }

  .service-cases {
    margin-top: 0;
    border-top: 1px solid #ded8ca;
    padding-top: clamp(18px, 2.4vw, 26px);
  }

  .service-cases h3 {
    margin: 0 0 14px;
    color: #777;
    font-family: "Manrope", "Noto Sans TC", sans-serif;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.2em;
  }

  .service-cases ul {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-cases li {
    min-width: 0;
  }

  .service-cases a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 16px;
    align-items: center;
    min-height: 72px;
    border: 1px solid #0077d9;
    padding: 14px 16px;
    background: #0077d9;
    color: #fff;
    text-decoration: none;
    transition:
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .service-cases a:hover {
    border-color: var(--home-yellow);
    background: var(--home-yellow);
    color: var(--home-ink);
    transform: translateY(-2px);
  }

  .service-cases__title {
    min-width: 0;
    font-size: clamp(0.96rem, 1.05vw, 1.08rem);
    font-weight: 900;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .service-cases__status-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    align-items: center;
    grid-column: 1;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .service-cases__status-row b {
    color: rgba(255, 255, 255, 0.92);
    font-family: "Manrope", "Noto Sans TC", sans-serif;
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.16em;
  }

  .service-cases__status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 24px;
    padding: 3px 10px 4px;
    border: 1px solid rgba(255, 255, 255, 0.86);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  .service-cases__status--active {
    border-color: rgba(255, 240, 25, 0.9);
    background: rgba(255, 240, 25, 0.18);
  }

  .service-cases__status--done {
    border-color: rgba(255, 255, 255, 0.86);
  }

  .service-cases a:hover .service-cases__status-row,
  .service-cases a:hover .service-cases__status-row b,
  .service-cases a:hover em {
    color: var(--home-ink);
  }

  .service-cases a:hover .service-cases__status {
    border-color: var(--home-ink);
    background: rgba(255, 255, 255, 0.28);
    color: var(--home-ink);
  }

  .service-cases em {
    grid-row: 1 / span 2;
    grid-column: 2;
    color: rgba(255, 255, 255, 0.82);
    font-style: normal;
    font-size: 1.4rem;
    line-height: 1;
  }

  .services-contact {
    width: min(calc(100% - var(--home-safe) * 2), 1180px);
    margin: clamp(68px, 8vw, 112px) auto 0;
    padding: clamp(34px, 6vw, 72px);
    background: var(--home-yellow);
  }

  .services-contact__label {
    margin: 0 0 24px;
    font-family: "Manrope", "Noto Sans TC", sans-serif;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.24em;
  }

  .services-contact h2 {
    margin: 0;
    max-width: 640px;
    font-size: clamp(1.7rem, 3vw, 2.9rem);
    line-height: 1.35;
    letter-spacing: 0.04em;
  }

  .services-contact p:not(.services-contact__label) {
    max-width: 700px;
