---
import Layout from "@/components/Layout.astro";
import LogoMarquee from "@/components/LogoMarquee.astro";
import { site } from "@/data/site";
import { withBase } from "@/utils/paths";

const hybridSupportItems = [
  { id: "monthly", title: "持續需求", description: "維持日常營運，延續更新與維護。" },
  { id: "occasional-support", title: "不定期綜合支援", description: "因應活動或其他面向的設計與製作需求。" },
  { id: "hybrid-meetings", title: "定期定點會議", description: "依約定時間與地點討論需求，確認下一階段工作。" },
  { id: "hybrid-progress", title: "KPI／進度時程", description: "共同設定工作指標、預計交付節點與進度回報方式。" }
] as const;

const cooperationQuestions = [
  { question: "知道目前有問題，卻還說不清楚要改什麼？", answer: "先一起釐清問題與優先事項，整理第一階段要完成的工作。透過半遠端合作，現場討論需求與方向，再遠端製作提案或初稿，依階段回饋逐步確認後續安排。" },
  { question: "專案已經完成，卻還會隨產品與營運持續微調？", answer: "先整理後續調整項目，區分急迫程度，再確認工作量與排程。半遠端可安排持續或不定期支援，平時遠端處理更新，遇到方向變動或較複雜的需求，再安排現場討論。" },
  { question: "要做網站、活動素材或印刷，公司卻缺少相關執行經驗？", answer: "先協助梳理製作流程、所需資料與確認節點，讓團隊知道各階段要準備什麼。半遠端合作可搭配現場對焦、遠端製作與定期會議，以交付項目、里程碑等 KPI／工作指標掌握進度。" },
  { question: "暫時沒有增聘專職人力的預算，工作卻仍需要推進？", answer: "先依預算排出優先事項，確認可投入的工作範圍、時間與報酬。可從短期半遠端合作開始，將現場討論與遠端製作排入階段時程，再依實際需求評估持續或不定期支援。" }
] as const;

const cooperationWorkflow = [
  { title: "討論需求與合約", description: "確認工作範圍、預算與合作條件，提供必要合約。" },
  { title: "執行／進度回報", description: "依確認的方向製作，整理已完成、進行中與待確認事項。" },
  { title: "二次修改", description: "依討論回饋調整製作內容，確認修改結果。" },
  { title: "確認交付與結案", description: "整理約定的交付內容，完成確認與結案。" }
] as const;

const cooperationStories = [
  {
    id: "website-support",
    industry: "資訊業",
    title: "從購物平台調整，延伸到活動與印刷。",
    initial: "先從購物平台的前端頁面調整開始，由我評估工作進度並協助網頁製作。",
    followUp: "合作中陸續加入活動平面、名片印刷與周邊商品製作，支援內容從網站延伸到其他設計與製作需求。"
  },
  {
    id: "campaign-support",
    industry: "教育業",
    title: "從 DM 與研習海報，延伸到社群經營與廣告發布。",
    initial: "原先委託我製作 DM 或研習海報。",
    followUp: "後續合作再延伸到社群經營與廣告發布，讓平面宣傳與線上內容能由同一個窗口接續支援。"
  },
  {
    id: "bakery-print-support",
    industry: "烘焙業",
    title: "從 DM 印製，延伸到貼紙與烘焙小卡。",
    initial: "原先需求是印製 DM。",
    followUp: "後續再延伸製作貼紙與烘焙小卡。"
  }
] as const;
---

<Layout title={`合作方式 | ${site.siteName}`} description={`從明確專案開始，以半遠端設計協作延伸持續需求與不定期支援。由 ${site.ownerDisplayName} 提供固定窗口、清楚排程與 KPI／工作指標討論，串接網站、平面及印刷製作。`} mainClass="cooperation-shell">
  <div class="cooperation-page">
    <header class="cooperation-hero" aria-labelledby="cooperation-title">
      <div class="cooperation-hero__handwriting" aria-hidden="true">let's goooo!</div>
      <h1 id="cooperation-title" class="reveal-line">合作模式</h1>
      <p class="home-label reveal-line">COOPERATION</p>
    </header>

    <section id="cooperation-approach" class="cooperation-section cooperation-approach" aria-labelledby="cooperation-approach-title">
      <h2 id="cooperation-approach-title" class="cooperation-approach__subtitle">從明確專案開始，依需求延續為半遠端合作。</h2>
      <p id="cooperation-shared-note" class="cooperation-note cooperation-shared-note">單次專案與半遠端合作，皆適用同一套合作流程。</p>
      <div class="cooperation-notebook" role="group" aria-label="專案與半遠端模式" aria-describedby="cooperation-shared-note">
        <section class="cooperation-notebook__project cooperation-flip-card" aria-labelledby="cooperation-project-title" tabindex="0">
          <div class="cooperation-flip-card__inner">
            <div class="cooperation-flip-card__face cooperation-flip-card__face--front">
              <p class="cooperation-flip-card__number">01</p>
              <h3 id="cooperation-project-title" class="cooperation-notebook__title">一般專案</h3>
              <p class="cooperation-flip-card__hint">明確需求，完成眼前目標</p>
            </div>
            <div class="cooperation-flip-card__face cooperation-flip-card__face--back">
              <h3 class="cooperation-flip-card__back-title">單次專案</h3>
              <p>以需求範圍、交付成果與排程為基礎，協助在確認的期間內完成一項專案。</p>
              <strong>適合：有明確專案目標</strong>
            </div>
          </div>
          <div class="cooperation-flip-card__details">
          <div id="project" class="cooperation-path__source">
            <h4>明確需求</h4>
            <p>完成眼前目標</p>
          </div>
          <section class="cooperation-shared-workflow" aria-labelledby="cooperation-shared-workflow-title">
            <h4 id="cooperation-shared-workflow-title">共用合作流程</h4>
            <ol>
              {cooperationWorkflow.map((step, index) => (
                <li>
                  <strong>{step.title}</strong><p>{step.description}</p>
                  {index < cooperationWorkflow.length - 1 && <span class="cooperation-shared-workflow__arrow" aria-hidden="true">↓</span>}
                </li>
              ))}
            </ol>
          </section>
          </div>
        </section>
        <section class="cooperation-notebook__hybrid cooperation-flip-card" aria-labelledby="cooperation-hybrid-title" tabindex="0">
          <div class="cooperation-flip-card__inner">
            <div class="cooperation-flip-card__face cooperation-flip-card__face--front">
              <p class="cooperation-flip-card__number">02</p>
              <h3 id="cooperation-hybrid-title" class="cooperation-notebook__title">半遠端模式</h3>
              <p class="cooperation-flip-card__hint">持續需求，保留合作產能</p>
            </div>
            <div class="cooperation-flip-card__face cooperation-flip-card__face--back">
              <h3 class="cooperation-flip-card__back-title">月度／半遠端合作</h3>
              <p>為持續性的設計與網站需求預留合作產能，可搭配固定遠端執行與部分現場協作。</p>
              <strong>適合：每個月都有持續的設計或網站需求</strong>
            </div>
          </div>
          <div class="cooperation-flip-card__details">
          <ul class="cooperation-path__extensions" aria-label="半遠端合作需求與安排">
            {hybridSupportItems.map((extension, index) => (
              <li id={extension.id}>
                <span class="cooperation-path__branch" aria-hidden="true"></span>
                <h4><span class="cooperation-path__marker" aria-hidden="true">{String.fromCharCode(97 + index)}.</span><span class="cooperation-path__label">{extension.title}</span></h4>
                <p>{extension.description}</p>
              </li>
            ))}
          </ul>
          <p class="cooperation-notebook__note">持續或不定期的工作，也依共用流程討論、追蹤、修改與階段結案。</p>
          </div>
        </section>
      </div>
    </section>

    <LogoMarquee class="cooperation-logo-marquee" />

    <section id="hybrid-benefits" class="cooperation-section cooperation-scenarios" aria-labelledby="hybrid-benefits-title">
      <header id="comparison" class="cooperation-heading">
        <h2 id="hybrid-benefits-title">常見的合作情境需求</h2>
        <p>需求還沒定案、專案需要持續調整，或暫時缺少執行人力時，都可以依工作範圍與預算，討論適合的半遠端合作安排。</p>
      </header>
      <dl class="cooperation-qa">
        {cooperationQuestions.map((item) => (
          <div>
            <dt>
              <span class="cooperation-qa__marker">Q.</span><span>{item.question}</span>
            </dt>
            <dd><span class="cooperation-qa__marker">A.</span><span>{item.answer}</span></dd>
          </div>
        ))}
      </dl>
      <p class="cooperation-note">合作契約、勞健保及相關費用，依實際合作關係與法令確認。</p>
    </section>

    <section id="cooperation-stories" class="cooperation-section cooperation-stories" aria-labelledby="cooperation-stories-title">
      <header class="cooperation-heading">
        <h2 id="cooperation-stories-title">實際合作案例</h2>
      </header>
      <div class="cooperation-stories__grid">
        {cooperationStories.map((story) => (
          <article class="cooperation-story" aria-labelledby={`${story.id}-title`}>
            <svg class="cooperation-story__folder cooperation-story__folder--top" viewBox="0 0 600 96" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <path d="M 1 96 V 25 Q 1 1 25 1 H 239 Q 259 1 259 21 V 49 Q 259 69 279 69 H 575 Q 599 69 599 93 V 96" />
            </svg>
            <svg class="cooperation-story__folder cooperation-story__folder--body" viewBox="0 0 600 400" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <path d="M 1 0 V 375 Q 1 399 25 399 H 575 Q 599 399 599 375 V 0" />
            </svg>
            <p class="cooperation-story__industry">產業類別：{story.industry}</p>
            <h3 id={`${story.id}-title`}>{story.title}</h3>
            <dl>
              <div><dt>原先的需求</dt><dd>{story.initial}</dd></div>
              <div><dt>後續的延伸</dt><dd>{story.followUp}</dd></div>
            </dl>
          </article>
        ))}
      </div>
      <p class="cooperation-note">以上為匿名合作經驗；實際合作範圍、週期與製作費用另行確認。</p>
    </section>

    <section class="cooperation-contact" aria-labelledby="cooperation-contact-title">
      <p class="home-label">CONTACT</p>
      <h2 id="cooperation-contact-title">你的需求，也正在持續延伸嗎？</h2>
      <p>無論是眼前的一項專案，或陸續出現的網站、平面與印刷需求，都可以先聊聊目前的目標、預算與時程，一起整理適合的合作節奏。</p>
      <a class="home-works-cta" href={withBase("/contact/")}><span>聊聊你的合作需求</span><span aria-hidden="true">→</span></a>
    </section>
  </div>
</Layout>
<style>
  @import url("https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&display=swap");

  :global(.cooperation-shell) { background: #f8f4ec; }

  .cooperation-page {
    --cooperation-rounded: "Zen Maru Gothic", "M PLUS Rounded 1c", "Noto Sans TC", sans-serif;
    --cooperation-body: "Noto Sans TC", sans-serif;
    --cooperation-ink: #26211a;
    --cooperation-muted: #6f6657;
    --cooperation-yellow: var(--home-yellow);
    --cooperation-yellow-deep: #a87908;
    --cooperation-card: #fffdf6;
    --cooperation-line: rgba(38, 33, 26, 0.15);
    width: min(calc(100% - var(--home-safe) * 2), 1240px);
    margin-inline: auto;
    padding-block: clamp(64px, 8vw, 112px) clamp(64px, 7vw, 96px);
    color: var(--cooperation-ink);
    font-family: var(--cooperation-body);
  }

  .cooperation-hero {
    display: grid;
    align-content: center;
    justify-items: center;
    min-height: clamp(220px, 28vh, 320px);
    padding-block: clamp(30px, 4.2vw, 56px);
    text-align: center;
  }

  .cooperation-hero__handwriting {
    position: relative;
    margin: 0 0 clamp(4px, 0.9vw, 10px);
    color: rgba(0, 119, 217, 0.76);
    font-family: var(--handwriting-font);
    font-size: clamp(1.85rem, 2.6vw, 3rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
    white-space: nowrap;
    transform: rotate(-13deg);
    clip-path: inset(0 100% 0 0);
    opacity: 0;
    animation: cooperation-handwriting-in 880ms cubic-bezier(0.16, 1, 0.3, 1) 160ms forwards;
  }

  .cooperation-hero .home-label,
  .cooperation-contact .home-label {
    font-family: var(--cooperation-rounded);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .cooperation-hero .home-label {
    margin: 10px 0 0;
    color: var(--cooperation-ink);
    font-size: clamp(0.82rem, 1vw, 0.98rem);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.24em;
    text-indent: 0.24em;
  }

  .cooperation-hero h1 {
    margin: 0;
    font-family: var(--cooperation-rounded);
    font-size: clamp(3rem, 7vw, 6.7rem);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: 0.12em;
    text-indent: 0.12em;
  }

  @keyframes cooperation-handwriting-in {
    0% {
      opacity: 0;
      clip-path: inset(0 100% 0 0);
      transform: translate3d(-12px, 8px, 0) rotate(-13deg);
    }

    48% {
      opacity: 0.68;
    }

    100% {
      opacity: 0.68;
      clip-path: inset(0 0 0 0);
      transform: translate3d(0, 0, 0) rotate(-13deg);
    }
  }

  .cooperation-section {
    padding-block: clamp(48px, 6.5vw, 80px);
    border-top: 1px solid var(--cooperation-line);
  }

  .cooperation-approach,
  .cooperation-stories { border-top: 0; }

  .cooperation-page [id] { scroll-margin-top: 112px; }
  .cooperation-heading { max-width: 920px; }

  .cooperation-heading h2 {
    margin: 0;
    font-family: var(--cooperation-rounded);
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 900;
    line-height: 1.35;
    letter-spacing: 0.03em;
    text-wrap: balance;
  }

  .cooperation-heading > p:last-child:not(.cooperation-eyebrow) {
    max-width: 44em;
    margin: 24px 0 0;
    color: var(--cooperation-muted);
    font-size: clamp(1rem, 1.16vw, 1.08rem);
    line-height: 1.9;
  }

  .cooperation-approach__subtitle {
    max-width: 1040px;
    margin: 0;
    color: var(--cooperation-ink);
    font-family: var(--cooperation-rounded);
    font-size: clamp(1.25rem, 2.1vw, 1.875rem);
    font-weight: 700;
    line-height: 1.55;
    text-wrap: balance;
  }

  .cooperation-shared-note { font-size: 1rem; }

  .cooperation-notebook {
    --cooperation-branch-gap: 36px;
    --cooperation-stack-gap: clamp(24px, 3vw, 40px);
    --cooperation-column-padding: clamp(20px, 2.5vw, 32px);
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 7fr);
    gap: var(--cooperation-stack-gap);
    margin: 32px 0 0;
  }

  .cooperation-notebook > section {
    min-width: 0;
    padding: var(--cooperation-column-padding);
    border-radius: clamp(16px, 2vw, 24px);
  }

  .cooperation-notebook__project {
    background: var(--cooperation-card);
    outline: 4px solid var(--cooperation-yellow);
    outline-offset: -4px;
  }

  .cooperation-notebook__hybrid {
    --cooperation-muted: #50432a;
    background: var(--cooperation-yellow);
  }

  .cooperation-flip-card {
    position: relative;
    aspect-ratio: 1;
    min-height: 0;
    padding: 0 !important;
    border-radius: 50% !important;
    outline: 0 !important;
    background: transparent !important;
    perspective: 1100px;
    cursor: pointer;
  }

  .cooperation-flip-card__inner { position: absolute; inset: 0; transform-style: preserve-3d; transition: transform 720ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .cooperation-flip-card:hover .cooperation-flip-card__inner,
  .cooperation-flip-card:focus-visible .cooperation-flip-card__inner { transform: rotateY(180deg); }
  .cooperation-flip-card__face { position: absolute; inset: 0; display: grid; align-content: center; justify-items: center; gap: 14px; padding: clamp(28px, 5vw, 68px); border: 3px solid var(--cooperation-yellow); border-radius: 50%; backface-visibility: hidden; text-align: center; }
  .cooperation-flip-card__face--front { background: var(--cooperation-card); }
  .cooperation-flip-card__face--back { transform: rotateY(180deg); background: var(--cooperation-yellow); }
  .cooperation-flip-card__number { margin: 0; color: var(--cooperation-yellow-deep); font-family: var(--cooperation-rounded); font-size: clamp(2.8rem, 5vw, 5rem); font-weight: 900; line-height: 1; }
  .cooperation-flip-card__face .cooperation-notebook__title { padding: 0; border: 0; font-size: clamp(1.35rem, 2.4vw, 2rem); line-height: 1.35; }
  .cooperation-flip-card__hint, .cooperation-flip-card__face--back p { max-width: 20em; margin: 0; color: var(--cooperation-muted); font-size: clamp(0.85rem, 1.2vw, 1rem); line-height: 1.8; }
  .cooperation-flip-card__back-title { margin: 0; font-family: var(--cooperation-rounded); font-size: clamp(1.25rem, 2vw, 1.75rem); line-height: 1.4; }
  .cooperation-flip-card__face--back strong { max-width: 20em; font-size: clamp(0.85rem, 1.2vw, 1rem); line-height: 1.7; }
  .cooperation-flip-card__details { display: none; }
  .cooperation-flip-card:focus-visible { outline: 3px solid var(--cooperation-ink) !important; outline-offset: 8px; }

  @media (prefers-reduced-motion: reduce) {
    .cooperation-flip-card__inner { transition: none; }
  }

  .cooperation-notebook__hybrid .cooperation-path__label {
    text-decoration-color: color-mix(in srgb, var(--cooperation-ink) 28%, transparent);
  }

  .cooperation-notebook__title {
    margin: 0;
    padding-bottom: 24px;
    border-bottom: 1px solid color-mix(in srgb, var(--cooperation-ink) 36%, transparent);
    font-family: var(--cooperation-rounded);
    font-size: clamp(1.75rem, 2.4vw, 2rem);
    font-weight: 900;
    line-height: 1.5;
  }

  .cooperation-path__source { margin-top: 28px; }

  .cooperation-path__source,
  .cooperation-path__extensions { min-width: 0; }

  .cooperation-path__extensions {
    display: grid;
    gap: var(--cooperation-branch-gap);
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .cooperation-path__extensions li { position: relative; min-width: 0; padding-left: 36px; }

  .cooperation-path__branch {
    position: absolute;
    inset: 0 auto 0 0;
    width: 24px;
    color: var(--cooperation-ink);
    opacity: 0.62;
  }

  .cooperation-path__branch::before,
  .cooperation-path__branch::after {
    content: "";
    position: absolute;
    left: 0;
    border-radius: 2px;
    background: currentColor;
  }

  .cooperation-path__branch::before {
    top: calc(var(--cooperation-branch-gap) / -2);
    bottom: calc(var(--cooperation-branch-gap) / -2);
    width: 2px;
  }
  .cooperation-path__branch::after { top: 50%; width: 23px; height: 2px; }

  .cooperation-path__extensions li:first-child .cooperation-path__branch::before {
    top: 50%;
    bottom: calc(var(--cooperation-branch-gap) / -2);
  }

  .cooperation-path__extensions li:last-child .cooperation-path__branch::before {
    top: calc(var(--cooperation-branch-gap) / -2);
    bottom: 50%;
  }

  .cooperation-path__source h4,
  .cooperation-path__extensions h4 {
    width: fit-content;
    margin: 0;
    font-family: var(--cooperation-rounded);
    font-size: clamp(1.375rem, 2vw, 1.625rem);
    font-weight: 700;
    line-height: 1.5;
  }

  .cooperation-path__source h4 {
    background: linear-gradient(transparent 56%, color-mix(in srgb, var(--cooperation-yellow) 58%, transparent) 56%, color-mix(in srgb, var(--cooperation-yellow) 58%, transparent) 94%, transparent 94%);
  }

  .cooperation-path__extensions h4 {
    display: flex;
    align-items: baseline;
    gap: 0.35em;
    color: var(--cooperation-ink);
  }

  .cooperation-path__marker {
    flex: 0 0 auto;
    font-size: 0.85em;
    white-space: nowrap;
  }

  .cooperation-path__label {
    min-width: 0;
    text-wrap: balance;
    text-decoration: underline;
    text-decoration-color: var(--cooperation-yellow);
    text-decoration-thickness: 0.14em;
    text-underline-offset: 0.1em;
    text-decoration-skip-ink: none;
  }

  .cooperation-path__source > p,
  .cooperation-path__extensions p {
    margin: 8px 0 0;
    color: var(--cooperation-muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .cooperation-notebook__note {
    margin: 28px 0 0 36px;
    max-width: 30em;
    color: var(--cooperation-muted);
