---
import Layout from "@/components/Layout.astro";
import PendingImage from "@/components/PendingImage.astro";
import { getCases } from "@/data/cases";
import type { CaseImage, CaseViewModel } from "@/data/case-model";
import { site } from "@/data/site";
import { withBase } from "@/utils/paths";

export async function getStaticPaths() {
  const cases = await getCases();
  return cases.map((caseStudy, index) => ({
    params: { slug: caseStudy.slug },
    props: {
      caseStudy,
      prev: cases[index - 1] ?? cases[cases.length - 1],
      next: cases[index + 1] ?? cases[0]
    }
  }));
}

interface Props { caseStudy: CaseViewModel; prev: CaseViewModel; next: CaseViewModel; }
const { caseStudy, prev, next } = Astro.props;
// Show each existing image once. The first image also serves as the project cover.

const relatedLink = caseStudy.relatedLink !== undefined
  ? caseStudy.relatedLink && { ...caseStudy.relatedLink, external: true }
  : caseStudy.externalUrl
  ? { label: "前往網站", href: caseStudy.externalUrl, external: true }
  : caseStudy.referenceLinks[0]
    ? { label: "查看相關作品", href: caseStudy.referenceLinks[0], external: true }
    : caseStudy.services[0]
      ? { label: caseStudy.services[0].title, href: withBase(`/services/#${caseStudy.services[0].slug}`), external: false }
      : undefined;
const contentImages: CaseImage[] = Array.from(caseStudy.contentHtml?.matchAll(/<img\b[^>]*\bsrc="([^"]+)"[^>]*>/gi) ?? []).map((match) => {
  const tag = match[0];
  const alt = tag.match(/\balt="([^"]*)"/i)?.[1] ?? "作品圖片";
  return { src: match[1], alt };
});
const gallery = [
  ...(caseStudy.coverImage ? [caseStudy.coverImage] : []),
  ...caseStudy.gallery,
  ...contentImages
].filter((item, index, items) => items.findIndex((candidate) => candidate.src === item.src) === index);
const summaryWithBreaks = caseStudy.summary.replace(/<br\s*\/?\s*>/gi, "\n");
---

<Layout title={`${caseStudy.title} | ${site.siteName}`} description={caseStudy.summary}>
  <article class="project case-study" data-content-status={caseStudy.contentStatus}>
    <a class="project-arrow project-arrow--prev" href={withBase(prev.url)} aria-label={`上一個案例：${prev.title}`}><span aria-hidden="true">‹</span></a>
    <a class="project-arrow project-arrow--next" href={withBase(next.url)} aria-label={`下一個案例：${next.title}`}><span aria-hidden="true">›</span></a>

    <header class="project__header case-hero">
      <a class="case-back" href={withBase("/works/")}>← 所有作品案例</a>
      <h1>{caseStudy.title}</h1>
      {caseStudy.categoryTerms.length > 0 && <div class="case-categories" aria-label="作品標籤">
        {caseStudy.categoryTerms.map((tag) => <span class="case-category-badge">{tag.label}</span>)}
      </div>}
    </header>

    <div class="project-viewer case-viewer">

      <div class="project-main case-main">
        <section class="case-summary" aria-label="作品簡短描述">
          <p>{summaryWithBreaks}</p>
        </section>
        {caseStudy.background && <section class="case-section" aria-labelledby="case-background-title"><h2 id="case-background-title">專案背景</h2><p>{caseStudy.background}</p></section>}
        {caseStudy.challenge && <section class="case-section" aria-labelledby="case-challenge-title"><h2 id="case-challenge-title">面對的課題</h2><p>{caseStudy.challenge}</p></section>}
        {caseStudy.approach && <section class="case-section" aria-labelledby="case-approach-title"><h2 id="case-approach-title">執行方式</h2><p>{caseStudy.approach}</p></section>}
        {caseStudy.deliverables.length > 0 && <section class="case-section" aria-labelledby="case-deliverables-title"><h2 id="case-deliverables-title">實際交付內容</h2><ul>{caseStudy.deliverables.map((item) => <li>{item}</li>)}</ul></section>}

        <section class="case-section case-gallery" aria-labelledby="case-gallery-title">
          <div class="project__media">
            {gallery.length > 0 ? gallery.map((item, index) => (
              <figure>
                <img src={withBase(item.src)} alt={item.alt} loading={index === 0 ? "eager" : "lazy"} />
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            )) : <PendingImage />}
          </div>
        </section>
        {relatedLink && (
          <section class="case-section case-link-section" aria-label="作品相關連結">
            <a class="case-related-link" href={relatedLink.href} target={relatedLink.external ? "_blank" : undefined} rel={relatedLink.external ? "noopener noreferrer" : undefined}>
              {relatedLink.label}<span aria-hidden="true">→</span>
            </a>
          </section>
        )}
        {caseStudy.outcomes.length > 0 && <section class="case-section" aria-labelledby="case-outcomes-title"><h2 id="case-outcomes-title">專案成果</h2><ul>{caseStudy.outcomes.map((item) => <li>{item}</li>)}</ul></section>}
      </div>
    </div>

    <nav class="case-navigation" aria-label="前後案例">
      <a href={withBase(prev.url)}><span>← 上一個案例</span><strong>{prev.title}</strong></a>
      <a href={withBase(next.url)}><span>下一個案例 →</span><strong>{next.title}</strong></a>
    </nav>
  </article>
</Layout>

<style>
  .case-study {
    width: min(calc(100% - 64px), 1280px);
    color: var(--home-ink);
  }
  .case-hero { padding: 0 clamp(22px,4vw,58px); margin-bottom: 0; }
  .case-hero h1 { max-width: 760px; overflow-wrap: anywhere; font-size: clamp(1.4rem, 1.98vw, 2.295rem); }
  .case-back { width: fit-content; margin-bottom: 12px; font-size: 0.85rem; font-weight: 700; }
  .case-categories { display: flex; flex-wrap: wrap; gap: 8px; }
  .case-hero .case-category-badge { width: fit-content; margin: 0; padding: 4px 12px; background: #c8c0b4; color: #2f2b27; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; }
  .case-category-badge:nth-child(5n + 1) { background: #c8c0b4; }
  .case-category-badge:nth-child(5n + 2) { background: #b9c4c0; }
  .case-category-badge:nth-child(5n + 3) { background: #c7b9b5; }
  .case-category-badge:nth-child(5n + 4) { background: #c4c3ad; }
  .case-category-badge:nth-child(5n + 5) { background: #b8bdca; }
  .case-viewer { display: block; }
  .case-main { min-width: 0; margin-top: clamp(28px, 4vw, 44px); padding-top: clamp(34px, 4vw, 58px); }
  .case-summary { margin: 0 0 40px; }
  .case-summary p { max-width: 1180px; margin: 0; color: var(--muted); font-size: clamp(0.85rem, 1vw, 1.05rem); line-height: 1.9; white-space: pre-line; }
  .case-section + .case-section { margin-top: 44px; padding-top: 32px; border-top: 1px solid var(--line); }
  .case-section h2 { margin: 0 0 20px; font-size: clamp(1.1rem,1.35vw,1.35rem); line-height: 1.5; }
  .case-section p, .case-section li { font-size: 0.95rem; line-height: 1.95; color: var(--muted); }
  .case-section p { white-space: pre-line; }
  .case-section ul { padding-left: 1.3em; }
  .case-gallery figure { min-width: 0; margin: 0; }
  .case-gallery figure img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }
  .case-gallery figcaption { margin-top: 12px; color: var(--muted); font-size: 0.8rem; }
  .case-editor :global(img) { display: block; width: auto; max-width: 100%; height: auto; margin-inline: auto; }
  .case-editor :global(figure) { min-width: 0; margin: 0 0 28px; }
  .case-editor :global(p), .case-editor :global(li), .case-editor :global(blockquote) { color: var(--muted); font-size: 0.95rem; line-height: 1.95; overflow-wrap: anywhere; }
  .case-editor :global(h2), .case-editor :global(h3), .case-editor :global(h4) { margin: 28px 0 16px; line-height: 1.5; }
  .case-editor :global(h2) { font-size: clamp(1.1rem,1.35vw,1.35rem); }
  .case-editor :global(figcaption) { margin-top: 12px; color: var(--muted); font-size: 0.8rem; text-align: center; }
  .case-editor :global(.wp-block-gallery) { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20px; }
  .case-editor :global(.wp-block-gallery figure) { margin: 0; }
  .case-editor :global(a) { color: var(--home-ink); text-decoration: underline; text-underline-offset: 4px; }
  .case-editor :global(table) { border-collapse: collapse; width: 100%; }
  .case-editor :global(th), .case-editor :global(td) { padding: 12px; border: 1px solid var(--line); }
  .case-editor :global(pre) { overflow-x: auto; padding: 16px; }
  .case-link-section { padding-block: 28px; }
  .case-related-link { display: inline-flex; gap: 12px; align-items: center; min-height: 56px; padding: 12px 0; border-bottom: 1px solid var(--line); color: var(--home-ink); font-weight: 700; overflow-wrap: anywhere; transition: color 220ms ease; }
  .case-related-link span { display: inline-block; transition: transform 220ms ease; }
  .case-related-link:hover, .case-related-link:focus-visible { color: var(--cursor-blue, #0077d9); }
  .case-related-link:hover span, .case-related-link:focus-visible span { transform: translateX(8px); }
  @media (prefers-reduced-motion: reduce) {
    .case-related-link, .case-related-link span { transition: none; }
  }
  .case-navigation { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 32px; margin: 48px 0 0; padding: 28px clamp(22px,4vw,58px); border-top: 1px solid var(--line); }
  .case-navigation a { display: grid; gap: 12px; min-width: 0; padding: 12px 0; }
  .case-navigation a:last-child { text-align: right; }
  .case-navigation span { color: var(--muted); font-size: 0.8rem; }
  .case-navigation strong { font-size: 1rem; line-height: 1.6; overflow-wrap: anywhere; }
  .case-study a:focus-visible { outline: 2px solid var(--home-ink); outline-offset: 4px; }
  @media (max-width: 640px) {
    .case-study { width: min(calc(100% - 32px), 1280px); }
    .case-editor :global(.wp-block-gallery) { grid-template-columns: minmax(0,1fr); }
    .case-navigation { grid-template-columns: minmax(0,1fr); gap: 16px; }
    .case-navigation a:last-child { text-align: left; border-top: 1px solid var(--line); padding-top: 24px; }
    .case-study .project-arrow { display: none; }
  }
</style>
