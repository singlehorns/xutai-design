---
import Layout from "@/components/Layout.astro";
import { contactContent, getContactCooperationOptions, getContactServiceOptions } from "@/data/contact";
import { publicProfile } from "@/data/profile";

const cooperationOptions = getContactCooperationOptions();
const serviceOptions = getContactServiceOptions();
---

<Layout
  title={`聯絡合作 | ${publicProfile.brandName}`}
  description={`填寫合作需求表單，與 ${publicProfile.ownerDisplayName} 討論品牌視覺、網站、印刷與數位內容合作需求。`}
  mainClass="contact-shell"
>
  <div class="contact-form-page" aria-labelledby="contact-title">
    <section class="contact-form-page__intro">
      <p class="contact-kicker">CONTACT</p>
      <h1 id="contact-title">填寫合作需求</h1>
      <p>留下目前想完成的事情、預計時程與聯絡方式，系統會整理成 LINE 訊息，方便你直接傳送需求內容。</p>
    </section>

    <section class="contact-form-panel" aria-labelledby="contact-form-title">
      <div class="contact-form-panel__heading">
        <p class="contact-step">REQUEST FORM</p>
        <h2 id="contact-form-title">先從需求開始。</h2>
        <p>如果內容還不完整，也可以先填目前已確定的部分。送出後會開啟 LINE，讓你確認文字後再傳送。</p>
      </div>

      <form class="contact-line-form" data-line-form aria-describedby="contact-form-status">
        <label>
          <span>姓名 / 稱呼 <em>必填</em></span>
          <input type="text" name="name" autocomplete="name" placeholder="請填寫稱呼" required />
        </label>

        <label>
          <span>公司 / 品牌名稱</span>
          <input type="text" name="company" autocomplete="organization" placeholder="公司或品牌名稱" />
        </label>

        <label>
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" placeholder="name@example.com" />
        </label>

        <label>
          <span>LINE 或其他聯絡方式</span>
          <input type="text" name="lineContact" placeholder="LINE ID、電話或其他方便聯絡的方式" />
        </label>

        <label>
          <span>合作類型</span>
          <select name="cooperationType">
            {cooperationOptions.map((option) => <option value={option.label}>{option.label}</option>)}
          </select>
        </label>

        <label>
          <span>需求類型</span>
          <select name="serviceType">
            {serviceOptions.map((option) => <option value={option.label}>{option.label}</option>)}
          </select>
        </label>

        <label>
          <span>預計時程</span>
          <select name="schedule">
            {contactContent.scheduleOptions.map((option) => <option value={option}>{option}</option>)}
          </select>
        </label>

        <label>
          <span>預算 / 合作規模</span>
          <input type="text" name="budget" placeholder="可填預算範圍，或填尚不確定" />
        </label>

        <label class="contact-line-form__full">
          <span>需求簡述 <em>必填</em></span>
          <textarea name="message" rows="7" placeholder="請簡單描述想完成的事、目前已有資料、參考方向或希望討論的問題" required></textarea>
        </label>

        <div class="contact-line-form__actions">
          <button type="submit">用 LINE 傳送需求 <span aria-hidden="true">→</span></button>
          <button type="button" class="contact-line-form__copy" data-copy-line-message>複製需求文字</button>
        </div>

        <p id="contact-form-status" class="contact-form-status" data-line-status>
          表單內容不會儲存在網站中；按下按鈕後，會將內容整理成 LINE 訊息，由你確認後送出。
        </p>
      </form>
    </section>
  </div>
</Layout>

<script>
  const lineForm = document.querySelector<HTMLFormElement>("[data-line-form]");
  const lineStatus = document.querySelector<HTMLElement>("[data-line-status]");
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-line-message]");

  const getValue = (formData: FormData, key: string) => String(formData.get(key) ?? "").trim();

  const buildLineMessage = () => {
    if (!lineForm) return "";
    const formData = new FormData(lineForm);
    const lines = [
      "您好，我想討論 T2 的合作需求：",
      "",
      `姓名 / 稱呼：${getValue(formData, "name") || "未填寫"}`,
      `公司 / 品牌：${getValue(formData, "company") || "未填寫"}`,
      `Email：${getValue(formData, "email") || "未填寫"}`,
      `LINE / 聯絡方式：${getValue(formData, "lineContact") || "未填寫"}`,
      `合作類型：${getValue(formData, "cooperationType") || "未選擇"}`,
      `需求類型：${getValue(formData, "serviceType") || "未選擇"}`,
      `預計時程：${getValue(formData, "schedule") || "未選擇"}`,
      `預算 / 合作規模：${getValue(formData, "budget") || "未填寫"}`,
      "",
      "需求簡述：",
      getValue(formData, "message") || "未填寫"
    ];

    return lines.join("\n");
  };

  const copyLineMessage = async () => {
    const message = buildLineMessage();
    if (!message) return false;

    try {
      await navigator.clipboard.writeText(message);
      return true;
    } catch {
      return false;
    }
  };

  copyButton?.addEventListener("click", async () => {
    const didCopy = await copyLineMessage();
    if (lineStatus) {
      lineStatus.textContent = didCopy ? "已複製需求文字，可以貼到 LINE 或其他訊息中。" : "目前瀏覽器無法自動複製，請改用送出按鈕開啟 LINE。";
    }
  });

  lineForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!lineForm.checkValidity()) {
      lineForm.reportValidity();
      return;
    }

    const message = buildLineMessage();
    await copyLineMessage();

    if (lineStatus) {
      lineStatus.textContent = "已整理需求內容，正在開啟 LINE。送出前仍可在 LINE 裡確認與修改文字。";
    }

    const lineUrl = `https://line.me/R/msg/text/?${encodeURIComponent(message)}`;
    window.open(lineUrl, "_blank", "noopener,noreferrer");
  });
</script>

<style>
  :global(.contact-shell) {
    background: var(--home-white);
  }

  .contact-form-page {
    width: min(100% - var(--home-safe) * 2, 1120px);
    margin-inline: auto;
    padding-block: clamp(56px, 8vw, 112px);
  }

  .contact-form-page__intro {
    max-width: 760px;
    margin-bottom: clamp(42px, 6vw, 76px);
  }

  .contact-kicker,
  .contact-step {
    margin: 0;
    color: #737373;
    font-family: "Manrope", "Noto Sans TC", sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .contact-form-page__intro h1 {
    margin: 18px 0 24px;
    color: var(--home-ink);
    font-family: "Zen Maru Gothic", "Noto Sans TC", sans-serif;
    font-size: clamp(2.8rem, 7vw, 6.8rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.08;
  }

  .contact-form-page__intro p,
  .contact-form-panel__heading p,
  .contact-form-status {
    color: #5f5f5a;
    line-height: 1.9;
  }

  .contact-form-panel {
    display: grid;
    grid-template-columns: minmax(220px, 0.42fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    padding-top: clamp(36px, 5vw, 64px);
    border-top: 1px solid var(--line);
  }

  .contact-form-panel__heading h2 {
    margin: 14px 0 18px;
    color: var(--home-ink);
    font-family: "Zen Maru Gothic", "Noto Sans TC", sans-serif;
    font-size: clamp(1.8rem, 3vw, 3rem);
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 1.22;
  }

  .contact-line-form {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    padding: clamp(24px, 4vw, 44px);
    border: 1px solid #deded8;
    background: #fff;
  }

  .contact-line-form label {
    min-width: 0;
    display: grid;
    gap: 8px;
    color: #2f2f2c;
    font-size: 0.92rem;
    font-weight: 800;
  }

  .contact-line-form em {
    margin-left: 0.3em;
    color: #9f7b00;
    font-style: normal;
    font-size: 0.78em;
  }

  .contact-line-form input,
  .contact-line-form select,
  .contact-line-form textarea {
    width: 100%;
    min-width: 0;
    min-height: 50px;
    padding: 12px 14px;
    border: 1px solid #d6d3cb;
    border-radius: 0;
    background: var(--home-white);
    color: var(--home-ink);
    font: inherit;
    font-weight: 500;
  }

  .contact-line-form textarea {
    resize: vertical;
    line-height: 1.8;
  }

  .contact-line-form input:focus,
  .contact-line-form select:focus,
  .contact-line-form textarea:focus {
    outline: 2px solid var(--home-yellow);
    outline-offset: 2px;
    border-color: var(--home-ink);
  }

  .contact-line-form__full,
  .contact-line-form__actions,
  .contact-form-status {
    grid-column: 1 / -1;
  }

  .contact-line-form__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-top: 8px;
  }

  .contact-line-form button {
    min-height: 56px;
    border: 1px solid var(--home-ink);
    border-radius: 999px;
    padding: 0 28px;
    background: var(--home-ink);
    color: #fff;
    font: inherit;
    font-weight: 900;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: transform 180ms ease, background 180ms ease, color 180ms ease;
  }

  .contact-line-form button:hover,
  .contact-line-form button:focus-visible {
    transform: translateY(-2px);
    background: var(--home-yellow);
    color: var(--home-ink);
  }

  .contact-line-form__copy {
    background: #fff !important;
    color: var(--home-ink) !important;
  }

  .contact-line-form__copy:hover,
  .contact-line-form__copy:focus-visible {
    background: var(--home-yellow) !important;
  }

  .contact-form-status {
    margin: 6px 0 0;
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .contact-form-panel,
    .contact-line-form {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .contact-form-page {
      width: min(100% - 32px, 1120px);
      padding-block: 44px 72px;
    }

    .contact-line-form {
      padding: 22px 18px;
    }

    .contact-line-form__actions,
    .contact-line-form button {
      width: 100%;
    }

    .contact-line-form button {
      justify-content: center;
      padding-inline: 18px;
      letter-spacing: 0.04em;
    }
  }
</style>
