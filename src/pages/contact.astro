---
import Layout from "@/components/Layout.astro";
import { contactContent, getContactCooperationOptions, getContactServiceOptions } from "@/data/contact";
import { publicProfile } from "@/data/profile";

const cooperationOptions = getContactCooperationOptions();
const serviceOptions = getContactServiceOptions();
---

<Layout
  title={`聯絡合作 | ${publicProfile.brandName}`}
  description={`聯絡 ${publicProfile.brandName}，與 ${publicProfile.ownerDisplayName} 討論品牌視覺、網站、印刷與數位內容合作需求。`}
  mainClass="contact-shell"
>
  <div class="contact-page contact-page--phase8" aria-labelledby="contact-title">
    <section class="contact-hero contact-hero--phase8">
      <p class="contact-kicker">CONTACT</p>
      <h1 id="contact-title">{contactContent.title}</h1>
      <p>{contactContent.intro}</p>
    </section>

    <section class="contact-phase8-panel reveal" aria-labelledby="contact-start-title">
      <div>
        <p class="contact-step">01 / COOPERATION TYPE</p>
        <h2 id="contact-start-title">你目前比較接近哪一種合作？</h2>
      </div>
      <div class="contact-option-grid">
        {cooperationOptions.map((option) => (
          <article>
            <h3>{option.label}</h3>
            <p>{option.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="contact-phase8-panel reveal" aria-labelledby="contact-service-title">
      <div>
        <p class="contact-step">02 / SERVICE NEED</p>
        <h2 id="contact-service-title">需求可能包含哪些項目？</h2>
      </div>
      <div class="contact-option-grid contact-option-grid--services">
        {serviceOptions.map((option) => (
          <article>
            <h3>{option.label}</h3>
            <p>{option.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="contact-phase8-panel reveal" aria-labelledby="contact-form-title">
      <div>
        <p class="contact-step">03 / REQUEST FORM</p>
        <h2 id="contact-form-title">合作需求表單</h2>
        <p>{contactContent.formStatus.note}</p>
      </div>
      <form class="contact-request-form" aria-describedby="contact-form-status">
        <fieldset disabled>
          <legend>{contactContent.formStatus.label}</legend>
          <label>
            <span>姓名 / 稱呼</span>
            <input type="text" name="name" autocomplete="name" placeholder="請填寫稱呼" />
          </label>
          <label>
            <span>公司 / 品牌名稱（選填）</span>
            <input type="text" name="company" autocomplete="organization" placeholder="公司或品牌名稱" />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" placeholder="name@example.com" />
          </label>
          <label>
            <span>其他聯絡方式（選填）</span>
            <input type="text" name="contact" placeholder="可填 LINE 或其他聯絡方式" />
          </label>
          <label>
            <span>合作類型</span>
            <select name="cooperationType">
              {cooperationOptions.map((option) => <option value={option.id}>{option.label}</option>)}
            </select>
          </label>
          <label>
            <span>需求類型</span>
            <select name="serviceType">
              {serviceOptions.map((option) => <option value={option.id}>{option.label}</option>)}
            </select>
          </label>
          <label>
            <span>預計時程</span>
            <select name="schedule">
              {contactContent.scheduleOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </label>
          <label class="contact-request-form__full">
            <span>需求簡述</span>
            <textarea name="message" rows="5" placeholder="請簡單描述想完成的事、目前資料與預計時間"></textarea>
          </label>
          <button type="button" disabled>{contactContent.ctaLabel}</button>
        </fieldset>
        <p id="contact-form-status" class="contact-form-status">{contactContent.formStatus.label}。{contactContent.formStatus.note}</p>
      </form>
    </section>

    <section class="contact-phase8-panel reveal" aria-labelledby="contact-channel-title">
      <div>
        <p class="contact-step">04 / DIRECT CONTACT</p>
        <h2 id="contact-channel-title">聯絡方式狀態</h2>
        <p>{contactContent.privacyNote}</p>
      </div>
      <div class="contact-channel-list">
        {contactContent.contactChannels.map((channel) => (
          channel.available ? (
            <a class="contact-channel" href={channel.href}>
              <span>{channel.label}</span>
              <strong>{channel.value}</strong>
              <small>{channel.note}</small>
            </a>
          ) : (
            <article class="contact-channel contact-channel--pending">
              <span>{channel.label}</span>
              <strong>待確認</strong>
              <small>{channel.note}</small>
            </article>
          )
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .contact-page--phase8 {
    width: min(1180px, calc(100% - var(--home-safe) * 2));
    padding-block: clamp(48px, 7vw, 96px);
  }
  .contact-hero--phase8 {
    display: grid;
    gap: 18px;
    max-width: 860px;
    padding: 0 0 clamp(56px, 7vw, 96px);
  }
  .contact-kicker,
  .contact-step {
    margin: 0;
    color: #737373;
    font-family: "Manrope", "Noto Sans TC", sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .contact-hero--phase8 h1,
  .contact-phase8-panel h2 {
    margin: 0;
    color: var(--home-ink);
    font-family: "Manrope", "Noto Sans TC", sans-serif;
    line-height: 1.35;
  }
  .contact-hero--phase8 h1 {
    font-size: clamp(2.7rem, 7vw, 6.2rem);
  }
  .contact-hero--phase8 p:last-child,
  .contact-phase8-panel p {
    max-width: 760px;
    color: #626262;
    line-height: 1.95;
  }
  .contact-phase8-panel {
    display: grid;
    grid-template-columns: minmax(220px, 0.38fr) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 56px);
    padding-block: clamp(42px, 6vw, 76px);
    border-top: 1px solid #deded8;
  }
  .contact-phase8-panel h2 {
    margin-top: 14px;
    font-size: clamp(1.55rem, 2.6vw, 2.6rem);
  }
  .contact-option-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .contact-option-grid--services {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .contact-option-grid article,
  .contact-channel,
  .contact-request-form {
    min-width: 0;
    padding: clamp(20px, 2.6vw, 30px);
    border: 1px solid #deded8;
    background: var(--home-gray);
  }
  .contact-option-grid h3,
  .contact-channel strong {
    margin: 0;
    color: var(--home-ink);
    font-size: 1.04rem;
  }
  .contact-request-form fieldset {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .contact-request-form legend {
    grid-column: 1 / -1;
    margin-bottom: 8px;
    font-weight: 800;
  }
  .contact-request-form label {
    display: grid;
    gap: 8px;
    color: #3f3f3f;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .contact-request-form input,
  .contact-request-form select,
  .contact-request-form textarea {
    width: 100%;
    min-height: 46px;
    padding: 11px 12px;
    border: 1px solid #d2d2cc;
    background: #fff;
    color: #777;
    font: inherit;
  }
  .contact-request-form textarea {
    resize: vertical;
  }
  .contact-request-form__full,
  .contact-request-form button,
  .contact-form-status {
    grid-column: 1 / -1;
  }
  .contact-request-form button {
    min-height: 52px;
    border: 1px solid #c8c8c2;
    background: #e5e5df;
    color: #777;
    font-weight: 800;
    cursor: not-allowed;
  }
  .contact-form-status {
    margin: 18px 0 0;
    font-size: 0.9rem;
  }
  .contact-channel-list {
    display: grid;
    gap: 16px;
  }
  .contact-channel {
    display: grid;
    gap: 8px;
  }
  .contact-channel span {
    color: #737373;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .contact-channel small {
    color: #626262;
    line-height: 1.7;
  }
  @media (max-width: 900px) {
    .contact-phase8-panel,
    .contact-option-grid,
    .contact-option-grid--services {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .contact-page--phase8 {
      width: min(100% - 40px, 1180px);
    }
    .contact-request-form fieldset {
      grid-template-columns: 1fr;
    }
  }
</style>
