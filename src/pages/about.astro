---
import Layout from "@/components/Layout.astro";
import { contactContent } from "@/data/contact";
import { publicProfile } from "@/data/profile";
import { withBase } from "@/utils/paths";

const resumeDisabled = publicProfile.resume.status === "coming-soon";
---

<Layout
  title={`關於我 | ${publicProfile.brandName}`}
  description={`${publicProfile.brandName}由 ${publicProfile.ownerDisplayName} 提供品牌視覺、印刷、網站與數位內容相關服務。`}
>
  <div class="about-page about-page--v2">
    <section class="about-v2-hero reveal" aria-labelledby="about-title">
      <p class="about-section-label">ABOUT<span>關於</span></p>
      <div>
        <p class="about-v2-hero__brand">{publicProfile.brandName}</p>
        <h1 id="about-title">{publicProfile.ownerDisplayName}</h1>
        <p>{publicProfile.tagline}</p>
      </div>
    </section>

    <section class="about-v2-section reveal" aria-labelledby="about-brand-title">
      <p class="about-section-label">STUDIO<span>品牌定位</span></p>
      <div class="about-v2-copy">
        <h2 id="about-brand-title">T2 是一個個人工作室型服務。</h2>
        <p>{publicProfile.shortBio}</p>
        <p>{publicProfile.aboutIntro}</p>
      </div>
    </section>

    <section class="about-v2-section reveal" aria-labelledby="about-background-title">
      <p class="about-section-label">BACKGROUND<span>專業背景</span></p>
      <div class="about-v2-copy">
        <h2 id="about-background-title">服務範圍來自實際工作中累積的製作脈絡。</h2>
        <p>{publicProfile.backgroundSummary}</p>
        <div class="about-v2-card-grid">
          {publicProfile.backgroundAreas.map((area) => (
            <article class="about-v2-card">
              <h3>{area.title}</h3>
              <p>{area.summary}</p>
              <ul>
                {area.points.map((point) => <li>{point}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about-v2-section reveal" aria-labelledby="about-workflow-title">
      <p class="about-section-label">WORK STYLE<span>工作方式</span></p>
      <div class="about-v2-copy">
        <h2 id="about-workflow-title">我習慣先把需求整理清楚，再進入設計與製作。</h2>
        <ul class="about-v2-list">
          {publicProfile.workingStyle.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section id="experience" class="about-v2-section reveal" aria-labelledby="about-experience-title">
      <p class="about-section-label">EXPERIENCE<span>精簡經歷</span></p>
      <div class="about-v2-copy">
        <h2 id="about-experience-title">只保留能支撐目前服務定位的代表性經驗。</h2>
        <div class="about-v2-experience">
          {publicProfile.experienceSummaries.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about-v2-section reveal" aria-labelledby="about-tools-title">
      <p class="about-section-label">TOOLS<span>使用能力</span></p>
      <div class="about-v2-copy">
        <h2 id="about-tools-title">工具只作為支撐，重點是交付內容能被使用。</h2>
        <div class="about-v2-tools">
          {publicProfile.toolGroups.map((group) => (
            <article>
              <h3>{group.title}</h3>
              <p>{group.tools.join(" / ")}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about-v2-section about-v2-section--resume reveal" aria-labelledby="about-resume-title">
      <p class="about-section-label">RESUME<span>公開履歷</span></p>
      <div class="about-v2-copy">
        <h2 id="about-resume-title">{publicProfile.resume.label}</h2>
        <p>{publicProfile.resume.note}</p>
        <button class="v2-button v2-button--pending" type="button" disabled={resumeDisabled}>
          {publicProfile.resume.label}
          <span>公開版履歷未製作完成</span>
        </button>
      </div>
    </section>

    <section class="about-v2-cta reveal" aria-labelledby="about-cta-title">
      <p class="about-section-label">CONTACT<span>聯絡合作</span></p>
      <div>
        <h2 id="about-cta-title">{publicProfile.cta.title}</h2>
        <p>{contactContent.intro}</p>
        <a class="v2-button" href={withBase(publicProfile.cta.href)}>{publicProfile.cta.label}<span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .about-page--v2 {
    width: min(1180px, calc(100% - var(--home-safe) * 2));
  }
  .about-v2-hero,
  .about-v2-section,
  .about-v2-cta {
    display: grid;
    grid-template-columns: minmax(160px, 0.32fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    padding-block: clamp(56px, 7vw, 104px);
    border-top: 1px solid #deded8;
  }
  .about-v2-hero {
    border-top: 0;
    padding-top: clamp(48px, 6vw, 84px);
  }
  .about-v2-hero__brand {
    margin: 0 0 18px;
    color: #636363;
    font-weight: 700;
  }
  .about-v2-hero h1,
  .about-v2-copy h2,
  .about-v2-cta h2 {
    margin: 0;
    max-width: 820px;
    color: var(--home-ink);
    font-family: "Manrope", "Noto Sans TC", sans-serif;
    line-height: 1.35;
  }
  .about-v2-hero h1 {
    font-size: clamp(3rem, 8vw, 7rem);
    letter-spacing: 0.02em;
  }
  .about-v2-hero p:last-child,
  .about-v2-copy > p,
  .about-v2-cta p {
    max-width: 760px;
    color: #626262;
    line-height: 2;
  }
  .about-v2-copy h2,
  .about-v2-cta h2 {
    font-size: clamp(1.7rem, 3vw, 3rem);
  }
  .about-v2-card-grid,
  .about-v2-experience,
  .about-v2-tools {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 32px;
  }
  .about-v2-card,
  .about-v2-experience article,
  .about-v2-tools article {
    min-width: 0;
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid #deded8;
    background: var(--home-gray);
  }
  .about-v2-card h3,
  .about-v2-experience h3,
  .about-v2-tools h3 {
    margin: 0;
    font-size: 1.08rem;
  }
  .about-v2-card p,
  .about-v2-experience p,
  .about-v2-tools p {
    margin: 12px 0 0;
    color: #626262;
    line-height: 1.85;
  }
  .about-v2-card ul,
  .about-v2-list {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  .about-v2-card li,
  .about-v2-list li {
    position: relative;
    padding-left: 18px;
    color: #5f5f5f;
    line-height: 1.85;
  }
  .about-v2-card li::before,
  .about-v2-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--home-yellow);
  }
  .about-v2-section--resume .v2-button {
    margin-top: 12px;
  }
  .about-v2-cta .v2-button {
    margin-top: 20px;
  }
  .v2-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 54px;
    padding: 14px 22px;
    border: 1px solid var(--home-ink);
    background: var(--home-ink);
    color: var(--home-white);
    font-size: 0.93rem;
    font-weight: 700;
  }
  .v2-button--pending {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 3px;
    cursor: default;
    color: #686868;
    background: var(--home-gray);
    border-color: #d0d0cc;
  }
  .v2-button--pending span {
    font-size: 0.76rem;
    font-weight: 400;
  }
  @media (max-width: 760px) {
    .about-page--v2 {
      width: min(100% - 40px, 1180px);
    }
    .about-v2-hero,
    .about-v2-section,
    .about-v2-cta,
    .about-v2-card-grid,
    .about-v2-experience,
    .about-v2-tools {
      grid-template-columns: 1fr;
    }
    .about-v2-hero,
    .about-v2-section,
    .about-v2-cta {
      gap: 24px;
      padding-block: 54px;
    }
  }
</style>
