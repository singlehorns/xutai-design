---
import Layout from "@/components/Layout.astro";
import { publicProfile } from "@/data/profile";
import { withBase } from "@/utils/paths";
---

<Layout
  title={`經歷已整合至關於我 | ${publicProfile.brandName}`}
  description={`原經歷頁內容已整合至 ${publicProfile.brandName} 的關於我頁面。`}
>
  <section class="experience-redirect" aria-labelledby="experience-redirect-title">
    <p class="experience-kicker reveal">EXPERIENCE MOVED</p>
    <h1 id="experience-redirect-title" class="reveal">經歷內容已整合至關於我。</h1>
    <p class="reveal">
      網站目前以個人工作室品牌與企業服務為主，公開經歷已濃縮為能支撐服務定位的內容。
    </p>
    <a class="v2-button reveal" href={withBase("/about/#experience")}>前往 About 精簡經歷 <span aria-hidden="true">→</span></a>
  </section>
  <script is:inline>
    window.location.replace(`${import.meta.env.BASE_URL}about/#experience`);
  </script>
</Layout>

<style>
  .experience-redirect {
    width: min(960px, calc(100% - var(--home-safe) * 2));
    margin: 0 auto;
    padding-block: clamp(72px, 12vw, 150px);
  }
  .experience-redirect h1 {
    margin: 20px 0 0;
    max-width: 820px;
    font-size: clamp(2.2rem, 5vw, 5rem);
    line-height: 1.35;
  }
  .experience-redirect > p:last-of-type {
    max-width: 680px;
    color: #626262;
    line-height: 2;
  }
  .experience-redirect .v2-button {
    margin-top: 28px;
  }
  .v2-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 54px;
    padding: 14px 22px;
    border: 1px solid var(--home-ink);
    background: var(--home-ink);
    color: var(--home-white);
    font-size: 0.93rem;
    font-weight: 700;
  }
</style>
