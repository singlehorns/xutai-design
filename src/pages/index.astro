---
import Layout from "@/components/Layout.astro";
import CaseCard from "@/components/CaseCard.astro";
import { getFeaturedCases } from "@/data/cases";
import { experiencePlaceholders } from "@/data/home";
import { getFeaturedServices } from "@/data/services";
import { getFeaturedSolutions } from "@/data/solutions";
import { getFeaturedCooperations, commonWorkingMethods, commonWorkflow, onSiteMeetingNote } from "@/data/cooperations";
import { site } from "@/data/site";
import { publicProfile } from "@/data/profile";
import { contactContent } from "@/data/contact";
import { withBase } from "@/utils/paths";

const featuredServices = getFeaturedServices();
const featuredSolutions = getFeaturedSolutions();
const featuredCooperations = getFeaturedCooperations();

const featuredCases = await getFeaturedCases();
---

<Layout
  title={`${site.siteName} | 品牌視覺 × 網站 × 長期遠端支援`}
  description={`${site.siteName}（${site.brandFullName}）由 ${site.ownerDisplayName} 提供品牌視覺、印刷製作、WordPress 網站、社群與影音內容，以單次專案、固定月度合作或包時支援，協助企業的設計與製作需求。`}
  headerVariant="home"
  mainClass="home-page v2-home"
>
  <section id="home-hero" class="home-hero v2-hero" aria-labelledby="home-hero-title" data-home-section="hero">
    <div class="home-hero__media reveal-mask">
      <img src={withBase("/images/works/glitter8-catalog-mockup.jpg")} alt="GLITTER8 型錄設計作品" fetchpriority="high" />
    </div>
    <div class="home-hero__shade" aria-hidden="true"></div>
    <div class="home-hero__content">
      <p class="home-hero__kicker reveal-line">{site.siteName} / DESIGN & REMOTE SUPPORT</p>
      <h1 id="home-hero-title" class="home-hero__title" aria-label="品牌視覺 × 網站 × 長期遠端支援">
        <span class="reveal-line">品牌視覺</span>
        <span class="reveal-line"><mark>× 網站</mark></span>
        <span class="reveal-line">× 長期遠端支援</span>
      </h1>
      <p class="home-hero__lead reveal-line">品牌與平面設計、印刷輸出、WordPress／形象網站、社群廣告素材與影音內容，由我直接與你協作。</p>
      <p class="v2-hero__modes reveal-line">by {site.ownerDisplayName}</p>
      <p class="v2-hero__modes reveal-line">單次專案・固定月度合作・包時支援</p>
      <div class="v2-actions reveal-line">
        <a class="v2-button v2-button--yellow" href={withBase("/services/")}>查看服務項目 <span aria-hidden="true">→</span></a>
        <a class="v2-button v2-button--light" href={withBase("/contact/")}>討論合作需求 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <aside class="home-hero__side" aria-label="個人品牌工作室">
      <span>{site.siteName}</span><span>{site.ownerDisplayName}</span>
    </aside>
  </section>

  <section id="home-experience" class="home-section v2-section v2-experience" aria-labelledby="home-experience-title" data-home-section="experience">
    <header class="v2-section__head reveal">
      <p class="home-label">02 / PROJECT EXPERIENCE</p>
      <h2 id="home-experience-title">合作與專案經驗</h2>
      <p>從不同品牌、單位與專案累積的設計與製作經驗。</p>
    </header>
    <ul class="v2-logo-wall" aria-label="合作與專案經驗素材待補">
      {experiencePlaceholders.map((label) => (
        <li><span>{label}</span><small>LOGO／名稱待補</small></li>
      ))}
    </ul>
    <p class="v2-note">相關名稱與 Logo 整理中，已公開作品可於下方案例查看。</p>
  </section>

  <section id="home-services" class="home-skills v2-services" aria-labelledby="home-services-title" data-home-section="services">
    <div class="home-skills__wave home-skills__wave--top" aria-hidden="true">
      <svg viewBox="0 0 1440 96" preserveAspectRatio="none"><path d="M0,0 H1440 V34 C1180,96 940,70 720,40 C460,4 260,72 0,34 Z"></path></svg>
    </div>
    <div class="home-skills-line" aria-hidden="true">
      <svg viewBox="0 0 1440 220" preserveAspectRatio="none" focusable="false"><path class="home-skills-line__path" d="M96 146 C274 34 510 34 674 128 C824 214 1038 204 1300 72" /></svg>
    </div>
    <div class="home-skills__inner">
      <header class="home-skills__intro reveal">
        <p class="home-label">03 / SERVICES</p>
        <h2 id="home-services-title">從視覺到製作，<br />讓需求有完整的交付。</h2>
        <p>依照品牌的溝通目標與實際使用情境，整理五大服務所需的內容、形式與製作範圍。</p>
        <a class="v2-text-link" href={withBase("/services/")}>查看完整服務項目 <span aria-hidden="true">→</span></a>
      </header>
      <div class="home-skills__orbit" aria-hidden="true" data-skills-orbit>
        <span>Design</span><span>Web</span><span>Support</span>
        <i class="home-skills__dot home-skills__dot--yellow"></i><i class="home-skills__dot"></i>
        <i class="home-skills__dot home-skills__dot--white"></i><i class="home-skills__dot"></i><i class="home-skills__dot home-skills__dot--yellow"></i>
        <strong>DESIGN<br />SUPPORT</strong>
      </div>
      <div class="v2-services__grid">
        {featuredServices.map((service, index) => (
          <article class="v2-service reveal">
            <p class="v2-eyebrow">{String(index + 1).padStart(2, "0")} / {service.shortTitle}</p>
            <h3>{service.title}</h3>
            <p>{service.summary}</p>
            <p class="v2-service__examples">{service.deliverables.slice(0, 4).join("・")}</p>
            <a class="v2-text-link" href={withBase(`/services/#${service.slug}`)} aria-label={`了解${service.title}`}>了解服務內容 <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
    <div class="home-skills__wave home-skills__wave--bottom" aria-hidden="true">
      <svg viewBox="0 0 1440 260" preserveAspectRatio="none">
        <path class="home-skills__wave-layer home-skills__wave-layer--shade" d="M0,64 C220,108 450,70 660,52 C884,34 1040,78 1198,150 C1298,196 1370,204 1440,184 L1440,260 L0,260 Z"></path>
        <path class="home-skills__wave-layer home-skills__wave-layer--front" d="M0,100 C230,138 455,88 650,72 C860,54 1036,94 1188,172 C1296,228 1368,236 1440,212 L1440,260 L0,260 Z"></path>
      </svg>
    </div>
  </section>

  <section id="home-solutions" class="home-section v2-section" aria-labelledby="home-solutions-title" data-home-section="solutions">
    <header class="v2-section__head reveal">
      <p class="home-label">04 / SOLUTIONS</p>
      <h2 id="home-solutions-title">從一個需求，延伸到不同製作項目。</h2>
      <p>你正在建立品牌、籌備活動，或準備推出新商品？先從目標出發，安排需要的服務組合。</p>
    </header>
    <div class="v2-solutions-grid">
      {featuredSolutions.map((solution) => (
        <article class="v2-panel reveal">
          <h3>{solution.title}</h3><p>{solution.summary}</p>
          <ul class="v2-deliverables" aria-label={`${solution.title}可延伸的製作項目`}>
            {solution.deliverables.slice(0, 4).map((item) => <li>{item}</li>)}
          </ul>
          <a class="v2-text-link" href={withBase(`/solutions/#${solution.slug}`)} aria-label={`了解${solution.title}的整合方式`}>了解整合方式 <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
    <p class="v2-note">以上為服務情境示例，實際項目依需求與合作範圍確認。</p>
    <a class="v2-text-link" href={withBase("/solutions/")}>了解整合服務 <span aria-hidden="true">→</span></a>
  </section>

  <section id="home-cooperation" class="home-section v2-section v2-bordered" aria-labelledby="home-cooperation-title" data-home-section="cooperation">
    <header class="v2-section__head reveal">
      <p class="home-label">05 / COOPERATION</p>
      <h2 id="home-cooperation-title">依需求的節奏，選擇合作方式。</h2>
      <p>由 {site.ownerDisplayName} 作為固定窗口，從一次性的製作需求，到持續性的品牌支援。</p>
    </header>
    <div class="v2-cooperation-grid">
      {featuredCooperations.map((mode, index) => (
        <article class="v2-panel reveal">
          <p class="v2-eyebrow">0{index + 1}</p><h3>{mode.title}</h3><p>{mode.summary}</p>
          <p>適合：{mode.suitableFor[0]}</p>
          <a class="v2-text-link" href={withBase(`/cooperation/#${mode.slug}`)} aria-label={`了解${mode.title}`}>了解合作方式 <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
    <ul class="v2-methods" aria-label="共同工作方式">{commonWorkingMethods.map((method) => <li>{method}</li>)}</ul>
    <p class="v2-note">{onSiteMeetingNote}</p>
    <a class="v2-text-link" href={withBase("/cooperation/")}>了解合作方式 <span aria-hidden="true">→</span></a>
  </section>

  <section id="home-works" class="home-section v2-section v2-bordered" aria-labelledby="home-works-title" data-home-section="works">
    <header class="v2-section__head reveal">
      <p class="home-label">06 / SELECTED WORKS</p>
      <h2 id="home-works-title">從實際作品，了解設計的應用。</h2>
      <p>精選網站視覺與平面印刷案例，查看畫面與目前已整理的負責項目。</p>
    </header>
    <div class="works-grid home-works-grid v2-cases-grid">
      {featuredCases.map((caseStudy) => (
        <div class="v2-case">
          <CaseCard caseStudy={caseStudy} compact />
        </div>
      ))}
    </div>
    <a class="home-works-cta" href={withBase("/works/")}><span>查看所有作品案例</span><span aria-hidden="true">→</span></a>
  </section>

  <section id="home-process" class="home-section v2-section v2-bordered" aria-labelledby="home-process-title" data-home-section="process">
    <header class="v2-section__head reveal">
      <p class="home-label">07 / PROCESS</p>
      <h2 id="home-process-title">每個階段，都有清楚的下一步。</h2>
      <p>先確認目標與交付，再透過排程與回饋，逐步完成設計和製作。</p>
    </header>
    <ol class="v2-process">
      {commonWorkflow.map((step, index) => (
        <li class="reveal"><span class="v2-process__number">{String(index + 1).padStart(2, "0")}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>
      ))}
    </ol>
  </section>

  <section id="home-about" class="home-section v2-section v2-bordered v2-about" aria-labelledby="home-about-title" data-home-section="about">
    <header class="v2-section__head reveal">
      <p class="home-label">08 / ABOUT</p>
      <h2 id="home-about-title">{publicProfile.brandName}<br /><span class="v2-about__name">{publicProfile.ownerDisplayName}</span></h2>
    </header>
    <div class="v2-about__body reveal">
      <p>{publicProfile.shortBio}</p>
      <p>{publicProfile.aboutIntro}</p>
      <div class="v2-actions">
        <a class="v2-button" href={withBase("/about/")}>了解我的背景 <span aria-hidden="true">→</span></a>
        <button class="v2-button v2-button--pending" type="button" disabled>{publicProfile.resume.label}<span>公開版履歷未製作完成</span></button>
      </div>
    </div>
  </section>

  <section id="home-contact" class="home-contact v2-contact" aria-labelledby="home-contact-title" data-home-section="contact">
    <div class="home-contact__media reveal-mask">
      <img src={withBase("/images/works/glitter8-catalog-mockup.jpg")} alt="GLITTER8 型錄設計細節" loading="lazy" />
    </div>
    <div class="home-contact__panel reveal">
      <p class="home-label">09 / CONTACT</p>
      <h2 id="home-contact-title">{contactContent.title}</h2>
      <p class="home-contact__lead">{contactContent.intro}</p>
      <a class="home-contact__button" href={withBase("/contact/")}><span>{contactContent.ctaLabel}</span><span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>

<script>
  const orbit = document.querySelector<HTMLElement>("[data-skills-orbit]");
  const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (orbit) {
    const labels = Array.from(orbit.querySelectorAll<HTMLElement>("span"));
    const dots = Array.from(orbit.querySelectorAll<HTMLElement>(".home-skills__dot"));
    const baseAngles = [-90, 30, 165];
    const dotAngles = [-132, -38, 34, 116, 206];
    const dotRadii = [0.49, 0.36, 0.47, 0.29, 0.42];
    let ticking = false;
    const updateOrbit = () => {
      const rect = orbit.getBoundingClientRect();
      const height = window.innerHeight;
      const progress = Math.min(1, Math.max(0, (height - rect.top) / (height + rect.height)));
      const angle = motionPreference.matches ? 0 : progress * 34;
      const radius = orbit.offsetWidth * 0.38;
      labels.forEach((label, index) => {
        const radians = ((baseAngles[index] + angle) * Math.PI) / 180;
        label.style.setProperty("--orbit-x", `${Math.cos(radians) * radius}px`);
        label.style.setProperty("--orbit-y", `${Math.sin(radians) * radius}px`);
      });
      dots.forEach((dot, index) => {
        const radians = ((dotAngles[index] + angle * 0.85) * Math.PI) / 180;
        const radius = orbit.offsetWidth * dotRadii[index];
        dot.style.setProperty("--dot-x", `${Math.cos(radians) * radius}px`);
        dot.style.setProperty("--dot-y", `${Math.sin(radians) * radius}px`);
      });
      ticking = false;
    };
    const requestUpdate = () => {
      if (!ticking) { requestAnimationFrame(updateOrbit); ticking = true; }
    };
    updateOrbit();
    window.addEventListener("scroll", () => { if (!motionPreference.matches) requestUpdate(); }, { passive: true });
    window.addEventListener("resize", requestUpdate);
    motionPreference.addEventListener("change", requestUpdate);
  }
</script>

<style>
  /* Only layout needed for the V2 homepage; the existing global visual system stays intact. */
  .v2-hero { min-height: clamp(620px, calc(90svh - 88px), 860px); }
  .v2-hero .home-hero__content { width: min(1080px, 100%); padding: clamp(64px, 8vw, 110px) var(--home-safe); }
  .v2-hero .home-hero__title { font-size: clamp(2.6rem, 5.4vw, 5.2rem); line-height: 1.22; letter-spacing: 0.015em; font-family: "Manrope", "Noto Sans TC", sans-serif; }
  .v2-hero .home-hero__title span { -webkit-text-stroke: 0; color: var(--home-white); }
  .v2-hero .home-hero__title mark { -webkit-text-stroke: 0; }
  .v2-hero .home-hero__lead { max-width: 670px; font-weight: 500; line-height: 1.9; }
  .v2-hero__modes { margin: 20px 0 0; color: var(--home-yellow); font-size: 0.95rem; }
  .v2-actions { display: flex; flex-wrap: wrap; align-items: stretch; gap: 12px; margin-top: 30px; }
  .v2-button { display: inline-flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 54px; padding: 14px 22px; border: 1px solid var(--home-ink); background: var(--home-ink); color: var(--home-white); font-size: 0.93rem; font-weight: 700; transition: transform 220ms ease, background 220ms ease; }
  .v2-button:hover { transform: translateY(-3px); }
  .v2-button--yellow { background: var(--home-yellow); color: var(--home-ink); border-color: var(--home-yellow); }
  .v2-button--light { background: transparent; border-color: rgba(255,255,255,0.7); }
  .v2-button:focus-visible, .v2-text-link:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .v2-button--pending { flex-direction: column; align-items: flex-start; justify-content: center; gap: 3px; cursor: default; color: #686868; background: var(--home-gray); border-color: #d0d0cc; }
  .v2-button--pending span { font-size: 0.76rem; font-weight: 400; }
  .v2-button--pending:hover { transform: none; }
  .v2-section { padding-block: clamp(64px, 7.5vw, 104px); }
  .v2-section__head { max-width: 800px; margin-bottom: 36px; }
  .v2-section__head .home-label { margin-bottom: 20px; }
  .v2-section__head h2 { line-height: 1.45; }
  .v2-section__head > p:last-child:not(.home-label) { max-width: 680px; margin: 18px 0 0; color: #636363; line-height: 1.9; }
  .v2-bordered { border-top: 1px solid #e6e6e2; }
  .v2-note { margin: 22px 0 0; color: #696969; font-size: 0.9rem; }
  .v2-logo-wall { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); margin: 0; padding: 0; list-style: none; border-top: 1px solid #deded8; border-left: 1px solid #deded8; }
  .v2-logo-wall li { display: grid; align-content: center; justify-items: center; gap: 10px; min-height: 138px; padding: 24px 16px; border-right: 1px solid #deded8; border-bottom: 1px solid #deded8; text-align: center; background: var(--home-gray); }
  .v2-logo-wall span { font-weight: 700; }
  .v2-logo-wall small { color: #747474; font-size: 0.76rem; }
  .v2-services { margin-top: 42px; }
  .v2-services .home-skills__inner { grid-template-columns: minmax(0,1fr) minmax(0,0.8fr); gap: 48px 64px; padding-top: 88px; }
  .v2-services .home-skills__intro { width: 100%; justify-self: start; align-self: center; }
  .v2-services .home-skills__intro h2 { margin-top: 20px; font-size: clamp(1.7rem, 2.7vw, 2.7rem); line-height: 1.45; }
  .v2-services .home-skills__intro > p:not(.home-label) { margin-top: 22px; max-width: 520px; line-height: 1.9; }
  .v2-services .home-skills__orbit { grid-row: 1; width: min(100%, 380px); min-width: 0; margin-block: 32px; }
  .v2-services .home-skills__orbit strong { font-size: clamp(1.1rem, 2vw, 1.8rem); line-height: 1.3; letter-spacing: 0.08em; }
  .v2-services .home-skills__orbit span { min-width: 105px; min-height: 46px; font-size: 0.95rem; letter-spacing: 0.03em; }
  .v2-services__grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); grid-column: 1 / -1; gap: 24px; }
  .v2-service { min-width: 0; padding: 28px 0; border-top: 1px solid rgba(17,17,17,0.32); }
  .v2-eyebrow { margin: 0 0 16px; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.06em; }
  .v2-service h3, .v2-panel h3 { margin: 0; font-size: clamp(1.2rem, 1.7vw, 1.55rem); line-height: 1.45; }
  .v2-service > p:not(.v2-eyebrow) { margin: 16px 0 0; line-height: 1.9; }
  .v2-service .v2-service__examples { font-size: 0.86rem; color: #4e4c2e; }
  .v2-text-link { display: inline-flex; align-items: center; gap: 30px; min-height: 44px; margin-top: 24px; padding-block: 8px; border-bottom: 1px solid currentColor; font-size: 0.95rem; font-weight: 700; }
  .v2-solutions-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 24px; }
  .v2-panel { padding: clamp(24px, 3vw, 36px); min-width: 0; border: 1px solid #deded8; }
  .v2-panel > p:not(.v2-eyebrow) { color: #636363; line-height: 1.9; }
  .v2-deliverables { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 24px 0 0; list-style: none; }
  .v2-deliverables li { padding: 5px 10px; background: var(--home-gray); font-size: 0.85rem; }
  .v2-cooperation-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 24px; }
  .v2-methods { display: flex; flex-wrap: wrap; gap: 12px 24px; list-style: none; padding: 0; margin: 32px 0 0; }
  .v2-methods li::before { content: ""; display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 9px; background: var(--home-yellow); vertical-align: middle; }
  .v2-cases-grid { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 44px 32px; }
  .v2-case { min-width: 0; }
  .v2-case__context { border-top: 1px solid #e6e6e2; margin-top: 18px; padding-top: 6px; color: #686868; font-size: 0.9rem; line-height: 1.9; }
  .v2-case__context strong { color: var(--home-ink); margin-right: 6px; }
  .v2-case__context p { margin: 12px 0 0; }
  .v2-process { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 0 40px; }
  .v2-process li { display: flex; gap: 24px; padding: 24px 0; border-top: 1px solid #deded8; }
  .v2-process__number { flex-shrink: 0; color: #747474; font-family: "Manrope",sans-serif; font-weight: 700; }
  .v2-process h3 { margin: 0; font-size: 1.1rem; }
  .v2-process p { margin: 8px 0 0; color: #636363; font-size: 0.93rem; }
  .v2-about { display: grid; grid-template-columns: minmax(0,0.65fr) minmax(0,1.2fr); gap: 48px; }
  .v2-about__name { font-size: 0.56em; letter-spacing: 0.12em; }
  .v2-about__body p { margin: 0 0 20px; line-height: 2; color: #636363; }
  .v2-contact { margin-top: 0; }
  .v2-contact .home-label { margin-bottom: 24px; }
  .v2-contact h2 { line-height: 1.45; }
  :global(.v2-home .reveal) { animation: none; }
  @media (max-width: 980px) {
    .v2-services .home-skills__inner { grid-template-columns: minmax(0,1fr) minmax(0,0.8fr); gap: 36px; }
    .v2-services .home-skills__orbit { grid-column: 2; }
    .v2-services__grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .v2-cooperation-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .v2-hero { min-height: auto; }
