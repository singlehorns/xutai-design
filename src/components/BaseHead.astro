---
import { site } from "@/data/site";
import { withBase } from "@/utils/paths";
import handwritingFontUrl from "@/assets/fonts/caveat-latin-400-normal.woff2?url";
import { localizedPath } from "@/data/i18n";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const pathname = Astro.url.pathname.replace(/^\/xutai-design/, "").replace(/^\/(en|ja)(?=\/)/, "") || "/";
const canonicalPath = pathname.endsWith("/") ? pathname : `${pathname}/`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="author" content={site.ownerDisplayName} />
<meta property="og:site_name" content={site.siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta name="generator" content={Astro.generator} />
{(["zh-Hant", "en", "ja"] as const).map((locale) => <link rel="alternate" hreflang={locale} href={new URL(`/xutai-design${localizedPath(canonicalPath, locale)}`, Astro.site).href} />)}
<link rel="alternate" hreflang="x-default" href={new URL(`/xutai-design${canonicalPath}`, Astro.site).href} />
<title>{title}</title>
<link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
<link rel="preload" href={handwritingFontUrl} as="font" type="font/woff2" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Noto+Sans+TC:wght@400;500;700&display=swap"
  rel="stylesheet"
/>
