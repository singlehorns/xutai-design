---
import BaseHead from "./BaseHead.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { handwritingFontStack } from "@/data/handwriting-presets";
import "@/styles/handwriting.css";
import "@/styles/global.css";
import { localeFromPath } from "@/data/i18n";

interface Props {
  title?: string;
  description?: string;
  headerVariant?: "default" | "home";
  mainClass?: string;
}

const { title, description, headerVariant = "default", mainClass } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
---

<!doctype html>
<html lang={locale} style={`--handwriting-font: ${handwritingFontStack}`}>
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body id="top">
    <Header variant={headerVariant} />
    <main class={mainClass}>
      <slot />
    </main>
    <Footer />
    <a class="page-top-link" href="#top" aria-label="Back to page top">
      <span aria-hidden="true"></span>
      PAGE TOP
    </a>
    <script>
      const revealTargets = document.querySelectorAll(".reveal, .work-card, .capability-card, .timeline-item");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        revealTargets.forEach((target, index) => {
          if (target instanceof HTMLElement) {
            target.style.setProperty("--reveal-delay", `${Math.min(index % 4, 3) * 90}ms`);
          }
          observer.observe(target);
        });
      } else {
        revealTargets.forEach((target) => target.classList.add("is-visible"));
      }

    </script>
  </body>
</html>
