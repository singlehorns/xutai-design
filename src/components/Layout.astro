---
import BaseHead from "./BaseHead.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { handwritingFontStack } from "@/data/handwriting-presets";
import "@/styles/handwriting.css";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  headerVariant?: "default" | "home";
  mainClass?: string;
}

const { title, description, headerVariant = "default", mainClass } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant" style={`--handwriting-font: ${handwritingFontStack}`}>
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body id="top">
    <Header variant={headerVariant} />
    <main class={mainClass}>
      <slot />
    </main>
    <Footer />
    <a class="page-top-link" href="#top" aria-label="Back to page top">
      <span aria-hidden="true"></span>
      PAGE TOP
    </a>
    <div class="cursor-dot" aria-hidden="true"></div>
    <script>
      const revealTargets = document.querySelectorAll(".reveal, .work-card, .capability-card, .timeline-item");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        revealTargets.forEach((target, index) => {
          if (target instanceof HTMLElement) {
            target.style.setProperty("--reveal-delay", `${Math.min(index % 4, 3) * 90}ms`);
          }
          observer.observe(target);
        });
      } else {
        revealTargets.forEach((target) => target.classList.add("is-visible"));
      }

      const cursorDot = document.querySelector(".cursor-dot");
      const canUseFinePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (cursorDot instanceof HTMLElement && canUseFinePointer && !reduceMotion) {
        const interactiveTargets = "a, button, [role='button'], .work-card, .capability-card, .contact-panel";
        window.addEventListener("pointermove", (event) => {
          cursorDot.style.setProperty("--cursor-x", `${event.clientX}px`);
          cursorDot.style.setProperty("--cursor-y", `${event.clientY}px`);
          cursorDot.classList.add("is-visible");
        });
        document.addEventListener("pointerover", (event) => {
          if (event.target instanceof Element && event.target.closest(interactiveTargets)) {
            cursorDot.classList.add("is-active");
          }
        });
        document.addEventListener("pointerout", (event) => {
          if (event.target instanceof Element && event.target.closest(interactiveTargets)) {
            cursorDot.classList.remove("is-active");
          }
        });
        document.addEventListener("mouseleave", () => {
          cursorDot.classList.remove("is-visible", "is-active");
        });
      }
    </script>
  </body>
</html>
