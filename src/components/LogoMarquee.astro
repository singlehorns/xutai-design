---
import { experiencePlaceholders } from "@/data/home";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["logo-marquee", className]} aria-label="合作與專案經驗 Logo 跑馬燈，正式圖片整理中">
  <ul class="logo-marquee__track">
    {experiencePlaceholders.map((label) => (
      <li>
        <span class="logo-marquee__mark">T2</span>
        <span>{label}</span>
        <small>LOGO／名稱待補</small>
      </li>
    ))}
    {experiencePlaceholders.map((label) => (
      <li aria-hidden="true">
        <span class="logo-marquee__mark">T2</span>
        <span>{label}</span>
        <small>LOGO／名稱待補</small>
      </li>
    ))}
  </ul>
</div>

<style>
  .logo-marquee {
    position: relative;
    overflow: hidden;
    border-block: 1px solid #deded8;
    background: var(--home-gray);
    mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%);
  }

  .logo-marquee::before,
  .logo-marquee::after {
    content: "";
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    width: clamp(34px, 7vw, 96px);
    pointer-events: none;
  }

  .logo-marquee::before { left: 0; background: linear-gradient(90deg, var(--home-white), transparent); }
  .logo-marquee::after { right: 0; background: linear-gradient(270deg, var(--home-white), transparent); }

  .logo-marquee__track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: logo-marquee 28s linear infinite;
  }

  .logo-marquee:hover .logo-marquee__track { animation-play-state: paused; }

  .logo-marquee__track li {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 8px;
    width: clamp(220px, 24vw, 340px);
    min-height: clamp(118px, 11vw, 152px);
    padding: 22px 28px;
    border-right: 1px solid #deded8;
    text-align: center;
  }

  .logo-marquee__track li:nth-child(2n) { background: color-mix(in srgb, var(--home-yellow) 6%, var(--home-gray)); }

  .logo-marquee__mark {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border: 1px solid color-mix(in srgb, var(--home-ink) 48%, transparent);
    border-radius: 999px;
    color: var(--home-ink);
    font-family: "Manrope", "Noto Sans TC", sans-serif;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .logo-marquee__track span:not(.logo-marquee__mark) { font-weight: 800; letter-spacing: 0.02em; }
  .logo-marquee__track small { color: #747474; font-size: 0.76rem; letter-spacing: 0.06em; }

  @keyframes logo-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 640px) {
    .logo-marquee__track { animation-duration: 22s; }
    .logo-marquee__track li { width: clamp(180px, 62vw, 260px); min-height: 112px; padding: 20px; font-size: 0.88rem; }
    .logo-marquee__mark { width: 48px; height: 48px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-marquee__track { animation: none; transform: none; }
  }
</style>
